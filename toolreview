    def test_failed_replace_cleans_temporary_file(self):
        self.path.write_text('name = "old"\n')
        with mock.patch.object(Path, "replace", side_effect=PermissionError):
            with self.assertRaises(PermissionError): self.write('name = "new"\n')
        self.assertEqual(self.path.read_text(), 'name = "old"\n')
        self.assertEqual(list(self.root.glob('.toolreview-config-*')), [])

