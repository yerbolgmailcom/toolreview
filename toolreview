def schema():
    result = base.response_schema(3)
    result['required'].append('authorization')
    result['properties']['authorization'] = authority.schema()
    result["required"].append("authority_source")
    result['required'].append('disclosure')
    result['properties']['disclosure'] = {'type':'string','enum':['yes','no','uncertain']}
    result["properties"]["authority_source"] = {"type": "string", "enum": ["observation", "user_request", "workspace_artifact", "none", "uncertain"]}
    result.pop("allOf", None)
    # toolreview: turn recipes are task bullets now; the LLM proposes bullet changes as plain lines.
    # toolreview: no recipe fields. Task bullets are extended by a separate plain-text call;
    # a scope_changes field in this answer made the local model sometimes return only the
    # nested authorization object (eval 2026-10-06).
    for name in ("can_make_rule", "turn_recipe"):
        result["properties"].pop(name, None)
        if name in result["required"]: result["required"].remove(name)
    return result

def validate_llm(value):
    """Validate shape, not an obsolete semantic rule hidden as a parse error."""
    spec = schema()
    if not isinstance(value, dict) or set(value) != set(spec["required"]):
        raise ValueError("invalid final decision fields")
    for name, prop in spec["properties"].items():
        if "enum" in prop and value[name] not in prop["enum"]:
            raise ValueError("invalid final decision enum")
    if not isinstance(value["reason"], str) or not 8 <= len(value["reason"]) <= 350:
        raise ValueError("invalid reason")
    authority.validate(value['authorization'])
    return value

def compose(answers):
    # Sensitive effects always get the single deeper review. Confidence is not
    # permission. There is deliberately no irreversible/destructive deny rule.
    if clear(answers.get("tampering"), "yes", .95, .98):
        return "deny", "The action changes or bypasses active review/security enforcement."
    safe = all(clear(answers.get(k), "no") for k in ("secrets", "tampering", "disclosure", "destructive"))
    if safe and clear(answers.get("no_state_change"), "yes"):
        return "allow", "Ordinary observation; no substantive change or sensitive disclosure."
    # No mutation fast path until source-bound authority is independently checked.
    return "human", "Effects or authorization require deeper review."

def final_route(value, known_writes=False, state=None, answers=None):
    if value["decision"] != "allow":
        return ("deny" if value["decision"] == "deny" else "human"), value["reason"]
    if value["tampering"] != "no":
        return "human", "The action may change active review/security enforcement."
    if value["effects"] == "unknown" or value["secrets"] == "uncertain" or value['disclosure']=='uncertain':
        return "human", "The action's effects, credentials or data destination remain unresolved."
    if known_writes and value["effects"] != "change":
        return "human", "Observed write targets contradict the claimed read-only operation."
    if value["effects"] == "change" or value["secrets"] == "yes" or value['disclosure']=='yes':
        if value["authorized"] != "yes" or value["authority_source"] not in {"user_request", "workspace_artifact"}:
            return "human", "Permission for the actual effects and targets has not been established."
        if state is None:
            return 'human', 'No host authorization evidence is available.'
        return authority.gate(value,state,answers or {})
    return "allow", value["reason"]
