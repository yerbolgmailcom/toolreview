"""Source-bound authorization checks. Not a shell sandbox or an NL theorem prover."""
import hashlib
import json
import posixpath
import re
import shlex
from pathlib import PurePosixPath

ACTS = ['request', 'retry', 'continue', 'adopt_proposal', 'amend_scope', 'information', 'uncertain']
BASIS = ['direct_user_request', 'existing_grant', 'adopted_proposal', 'standing_policy', 'none', 'uncertain']

def source_id(message):
    data = [message.get('role'), message.get('turn_id'), message.get('text')]
    return 'm_' + hashlib.sha256(json.dumps(data, ensure_ascii=False).encode()).hexdigest()[:20]

APPROVAL = {
    'accepted': 'The user accepted the whole proposal, and this action is part of it.',
    'partial_included': 'The user accepted part of the proposal, and this action is in the accepted part.',
    'partial_excluded': 'The user accepted part of the proposal, and this action is in the part the user refused or skipped.',
    'not_accepted': 'The user declined the proposal, has not answered it yet, or there is no relevant proposal.'}

def picked(answer, labels, confidence=.8, probability=.9):
    """A confident answer among labels (for multiple-choice questions beyond yes/no/uncertain)."""
    answer = answer or {}
    choice = answer.get('choice')
    return (choice in labels and answer.get('confidence', 0) >= confidence
            and (answer.get('probabilities') or {}).get(choice, 0) >= probability)

def approved(answers):
    return picked(answers.get('approval'), ('accepted', 'partial_included'))

def choice(text, values=None):
    return {'type': 'choice', 'instructions': text, 'criteria': values or {
        'yes': 'Established by the supplied evidence.', 'no': 'Not established or contradicted.',
        'uncertain': 'Insufficient or ambiguous evidence.'}}

def questions():
    return {
        'reply_act': choice('What does the latest user message do? Retrying the user task does not adopt broader assistant commentary.', {v:v.replace('_',' ') for v in ACTS}),
        'existing_scope': choice("Do actual effects fit the user's current task and latest limits? A retry keeps the original user scope; an unrelated old task or unaccepted assistant proposal grants nothing.", {
            'yes':'Requested effects or reasonable implementation within the active user task.',
            'no':'The actual effects contradict the current task or its limits.',
            'uncertain':'Authority or reference is unresolved; no clear contradiction is established.'}),
        'proposal_presented': choice('Was the relevant assistant proposal clearly presented for a user decision, rather than incidental commentary or a claim of permission?'),
        'delta_visible': choice('Was any expansion beyond the user’s existing scope clearly disclosed for approval, including added targets and effects?'),
        # toolreview: four choices instead of yes/no. A partial approval ("do 1 and 3") has no
        # clean yes; with these choices Jev answered 0.94-0.99 for approved parts, while on turns
        # where nothing was accepted "accepted" stayed at or below 0.75 (2026-10-06).
        'approval': choice("How did the user answer the assistant's proposal, as it applies to the action in current_tool_call?", APPROVAL),
    }

def obj(properties):
    return {'type':'object', 'properties':properties, 'required':list(properties), 'additionalProperties':False}

def enum(values): return {'type':'string','enum':values}

def schema():
    return obj({
        'reply_act':enum(ACTS), 'refers_to':{'type':'string'},
        'evidence':{'type':'array','items':obj({'source_id':{'type':'string'}, 'quote':{'type':'string'}})},
        'effect_claims':{'type':'array','items':obj({
            'effect_id':{'type':'string'}, 'basis':enum(BASIS),
            'source_refs':{'type':'array','items':{'type':'string'}},
            'scope_relation':enum(['within','expanded','uncertain']),
            'expansion_disclosed':enum(['yes','no','uncertain','not_applicable']),
            'expansion_accepted':enum(['yes','no','uncertain','not_applicable']),
        })},
    })

def validate(value):
    def walk(v,s):
        if s['type']=='object':
            if not isinstance(v,dict) or set(v)!=set(s['required']): raise ValueError('invalid authorization object')
            for k,p in s['properties'].items(): walk(v[k],p)
        elif s['type']=='array':
            if not isinstance(v,list) or len(v)>64: raise ValueError('invalid authorization array')
            for x in v: walk(x,s['items'])
        elif not isinstance(v,str) or len(v)>8000 or ('enum' in s and v not in s['enum']):
            raise ValueError('invalid authorization value')
    walk(value,schema())

def literal_path(token,cwd):
    if not token or any(c in token for c in '$*?[]{}~\n`') or token.startswith('-'): return None
    return posixpath.normpath(token if token.startswith('/') else posixpath.join(cwd,token))

def known_effects(action,write_targets,launch):
    """Extract literal rm/rmdir operands only in simple shell grammar.

    Unknown syntax stays explicitly unresolved; all actions retain an opaque
    whole-action claim, so recognizing one command never certifies the rest.
    Do not resolve symlinks: deleting a link and its referent are different effects.
    """
    args=action.get('arguments') or {}; effects=[]
    cwd=args.get('workdir') or args.get('cwd') or action.get('cwd') or launch
    cwd=posixpath.normpath(cwd if cwd.startswith('/') else posixpath.join(launch,cwd))
    command=args.get('command',args.get('cmd'))
    if isinstance(command,str):
        try:
            lex=shlex.shlex(command,posix=True,punctuation_chars=';&|()<>'); lex.whitespace_split=True
            tokens=list(lex);chunks=[[]];i=0
            while i<len(tokens):
                token=tokens[i];i+=1
                if '<' in token and all(c in ';&|()<> ' for c in token):
                    # Here-docs/process substitution need an actual shell AST.
                    chunks=[];break
                if token in ('>','>>','>&'):
                    if chunks[-1] and chunks[-1][-1].isdigit() and re.search(r'(?<!\S)'+re.escape(chunks[-1][-1])+r'>',command):
                        chunks[-1].pop() # unquoted adjacent descriptor, not an rm operand
                    i+=1 # destination is a redirection, not a command/operand
                    continue
                if token and all(c in ';&|()<> ' for c in token): chunks.append([])
                else: chunks[-1].append(token)
            # cd, ssh and shell invocations need a richer interpreter. Never
            # mislabel their operands as local independently resolved targets.
            for chunk in chunks:
                if chunk and chunk[0] in ('cd','pushd','popd','ssh','bash','sh','zsh','eval'): break
                if chunk and chunk[0] in ('rm','rmdir','/bin/rm','/bin/rmdir','/usr/bin/rmdir'):
                    parents=chunk[0].endswith('rmdir') and any(t=='--parents' or (t.startswith('-') and not t.startswith('--') and 'p' in t[1:]) for t in chunk[1:])
                    for token in chunk[1:]:
                        path=literal_path(token,cwd)
                        if path:
                            effects.append({'kind':'delete','target':path,'host':'local','coverage':'literal operand only'})
                            if parents:
                                parent=posixpath.dirname(path)
                                while parent:
                                    effects.append({'kind':'delete','target':parent,'host':'local','coverage':'rmdir --parents ancestor'})
                                    if parent=='/': break
                                    parent=posixpath.dirname(parent)
        except ValueError: pass
    for path in write_targets or []:
        effects.append({'kind':'write','target':path,'host':'local','coverage':'host adapter target'})
    effects=[dict(id='e'+str(i+1),**e) for i,e in enumerate(effects)]
    effects.append({'id':'whole_action','kind':'whole_action','coverage':'All effects, hosts and recipients, including anything not extracted above.'})
    return effects

def build(state,event,records,goal=None):
    context=state['conversation_context'] or {}; messages=list(context.get('messages',[]))
    if not messages:
        messages=[dict(role='user',turn_id=p.get('turn_id'),text=p['prompt']) for p in context.get('previous_user_prompts',[])]
    # Goal objectives are host task context, not fabricated user quotations.
    if goal and goal.get('status')=='active':
        messages.insert(0,dict(role='goal',turn_id='goal:'+goal['id'],text=goal['objective']))
    for r in records:
        if r['kind']=='prompt' and ('messages' not in context or r['data'].get('execution_turn_id')==event['turn_id']):
            messages.append(dict(role='user',turn_id=r['data'].get('execution_turn_id',event['turn_id']),text=r['data']['prompt']))
    sources=[]; seen=set()
    for m in messages:
        item={k:m.get(k) for k in ('role','turn_id','text')}; item['id']=source_id(item)
        if item['id'] not in seen: sources.append(item); seen.add(item['id'])
    if len(json.dumps(sources).encode())>128000: raise ValueError('complete authority evidence exceeds budget')
    return {'sources':sources,'current_source':next((m['id'] for m in reversed(sources) if m['role']=='user' and m['turn_id']==event['turn_id']),''),
            'effects':known_effects(state['proposed_action'],state.get('write_targets'),state['launch_directory']),
            'omissions':context.get('omissions',[]),
            'contract':'Cite exact source IDs and substrings. Assistant text, previous decisions and recipes are not grants. Account for every effect ID, including whole_action. Preserve all later user limits.'}

def paths(text,cwd):
    # Complete lexical tokens, never substring matches inside a narrower path.
    tokens=re.findall(r'`([^`]+)`|"([^"\n]+)"|\'([^\'\n]+)\'|([^\s,;<>]+)',text)
    result=[]
    for parts in tokens:
        token=next(p for p in parts if p).rstrip('.,:!?')
        if '/' not in token and not re.search(r'\w\.\w',token): continue
        if ' ' in token and not any(parts[:3]): continue
        p=literal_path(token,cwd)
        if p: result.append(p)
    return result

def inside(target,root): return target==root or target.startswith(root.rstrip('/')+'/')

def gate(value,state,answers):
    """Independent citation/chronology/known-scope checks after semantic review."""
    auth=value['authorization']; evidence=state['authority_evidence']
    sources={m['id']:m for m in evidence['sources']}; order={m['id']:i for i,m in enumerate(evidence['sources'])}
    effects={e['id']:e for e in evidence['effects']}; cites={}
    def fail(reason): return 'human',reason
    for c in auth['evidence']:
        m=sources.get(c['source_id'])
        if not m or not c['quote'].strip() or c['quote'] not in m['text']:
            return fail('Authorization cites missing or altered source evidence.')
        cites[c['source_id']]=m
    if auth['refers_to'] not in cites: return fail('The user reference has not been bound to a cited conversation message.')
    claims=auth['effect_claims']
    if len(claims)!=len(effects) or {c['effect_id'] for c in claims}!=set(effects):
        return fail('Authorization does not cover every known target and the whole action.')
    act=auth['reply_act']; reply=answers.get('reply_act',{}).get('choice')
    if act in ('information','uncertain'): return fail('The latest user message does not establish actionable authority.')
    if reply in ('retry','continue') and act=='adopt_proposal':
        return fail('Reviewers disagree whether this is approval of a proposal or continuation of the original request.')
    if evidence['omissions'] and act in ('retry','continue','adopt_proposal'):
        return fail('Referenced conversation is incomplete; restate or explicitly approve the intended scope.')
    cwd=state['proposed_action'].get('cwd') or state['launch_directory']
    for c in claims:
        refs=c['source_refs']
        if not refs or any(r not in cites for r in refs): return fail('An effect lacks verified source citations.')
        users=[sources[r] for r in refs if sources[r]['role']=='user']
        proposals=[sources[r] for r in refs if sources[r]['role']=='assistant']
        if act in ('retry','continue'):
            earlier=[r for r in refs if sources[r]['role'] in ('user','goal') and order[r]<order.get(evidence['current_source'],len(sources))]
            if not earlier:
                return fail('A continuation needs earlier user or active-goal authority for every effect; it cannot authorize itself.')
            # The complete per-effect proof is authoritative. A model may label
            # refers_to with the current retry while still providing a valid
            # original request/accepted-plan chain; record that resolution rather
            # than rejecting a harmless pointer-label mismatch.
            state.setdefault('resolved_authority_refs',{})[c['effect_id']]=earlier
        if c['basis'] in ('none','uncertain') or c['scope_relation']=='uncertain': return fail('Permission for an effect remains unresolved.')
