#!/bin/sh
# toolreview: per-project tool-call reviewer for Codex (plain Codex or a separate CODEX_HOME such as codex-local).
#
# One file. The shell code comes first, then `exit`, then verbatim assets: the
# reviewer's Python code and schemas, its tests, the hook definitions and a
# trust helper, each read back by name with `asset`.
#
# The reviewer's code never goes into a project. `install` writes only
# .codex/hooks.json (hooks that call this script) and an empty state folder
# (.<name>/) for the review history. At review time `hook` unpacks the code into
# a cache keyed by this file's sha256, keeping the last 10 versions, and runs it
# there. A copy named toolreview-experimental keeps its own cache and its own
# state folder (.toolreview-experimental/), so both versions can run side by side.
#
# Copyright (c) 2026 Yerbol Akhmetbekov. SPDX-License-Identifier: MIT
# Extracted from the author's reviewer development tree; see docs/PROVENANCE.md.
#
# Install the command: ln -sfn /path/to/toolreview/<name> ~/.local/bin/<name>
set -eu

SELF=$(readlink -f "$0")
NAME=$(basename "$SELF")
STATE_DIR=".$NAME"
LINK="$HOME/.local/bin/$NAME"
HOOK_COMMAND="$LINK hook"
# Settings (classifier, resolver, Codex home) live in this file, never in the code; see
# `$NAME config`. Stable and experimental copies read separate files.
export TOOLREVIEW_CONFIG=${TOOLREVIEW_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/$NAME/config.toml}
CACHE_ROOT=${XDG_CACHE_HOME:-$HOME/.cache}/toolreview/$NAME
KEEP=10
CODE="judge.py arbiter.py policy.py authority.py prototype.py host_adapter.py base-schema.json judge-response.schema.json recipe.example.json entry.py eval.py bullets.py scope_proposal.py bullet_worker.py config.py .gitignore"
TESTS="trust.py test_config.py test_authority.py test_general.py test_host_adapter.py test_judge.py test_v3.py fixtures/base-v2.json"

asset() {   # print the asset named $1 from this file, verbatim (exact line match, no regex)
  NAME=$1 awk '
    BEGIN { start = "#=== ASSET " ENVIRON["NAME"] " ===" }
    $0 == start                { on = 1; next }
    on && $0 == "#=== END ===" { exit }
    on
  ' "$SELF"
}
say() { echo "$NAME: $*" >&2; }
die() { say "$*"; exit 1; }
version() { sha256sum "$SELF" | cut -c1-64; }

unpack() {  # unpack <dir> <asset>...
  dir=$1; shift
  for a in "$@"; do mkdir -p "$dir/$(dirname "$a")"; asset "$a" > "$dir/$a"; done
}

code_dir() {  # the cache folder for this version, unpacked atomically if missing
  v=$1; d="$CACHE_ROOT/$v"
  if [ ! -f "$d/.complete" ]; then
    mkdir -p "$CACHE_ROOT"
    tmp=$(mktemp -d "$CACHE_ROOT/.unpack.XXXXXX")
    unpack "$tmp" $CODE
    touch "$tmp/.complete"
    mv -T "$tmp" "$d" 2>/dev/null || rm -rf "$tmp"   # a parallel hook got there first
    prune "$v"
  fi
  touch "$d/.used"
  echo "$d"
}

prune() {  # keep the $KEEP most recently used versions, always including $1
  ls -1t "$CACHE_ROOT"/*/.used 2>/dev/null | tail -n +$((KEEP + 1)) | while read -r used; do
    old=$(dirname "$used")
    [ "$(basename "$old")" = "$1" ] || rm -rf "$old"
  done
}

run_tests() {
  tmp=$(mktemp -d)
  unpack "$tmp" $CODE $TESTS
  ok=0
  for t in $TESTS; do
    case $t in test_*.py) (cd "$tmp" && TOOLREVIEW_CONFIG="$tmp/no-config.toml" python3 -m unittest -q "${t%.py}") >"$tmp/.log" 2>&1 || { ok=1; say "FAILED: $t"; tail -20 "$tmp/.log" >&2; } ;; esac
  done
  rm -rf "$tmp"
  return $ok
}

ours() {  # is <project>/.codex/hooks.json ours?
  [ -f "$1/.codex/hooks.json" ] && grep -qF "\"$HOOK_COMMAND\"" "$1/.codex/hooks.json"
}

setting() { python3 "$(code_dir "$(version)")/config.py" get "$1"; }   # one config value
codex_home() { setting codex.home; }
trust() { asset trust.py | python3 - "$1" "$2" "$(codex_home)" "$HOOK_COMMAND"; }

usage() {
  cat <<USAGE
$NAME: tool-call reviewer for Codex, installed per project.

Usage: $NAME <command>   (run in the project folder)

  install [--force]  add the hooks (.codex/hooks.json), the state folder
                     ($STATE_DIR/) and the Codex trust for this folder;
                     runs the tests first. --force replaces foreign hooks.json.
  uninstall [--purge] remove the hooks and their trust; --purge also deletes
                     $STATE_DIR/ (the review history).
  status             this script's version, its cache, and this folder's setup.
  config [--check]   the effective settings and where each came from (no
                     secret values); --check tests the classifier key and
                     that the resolver answers.
  test               run the reviewer's tests in a temporary folder.
  eval <set> [opts]  run the real reviewer on a frozen case set (e.g.
                     examples/eval) and save the run under
                     <set>/runs/. Options: --repeats N, --only ID,...,
                     --replay RUN (no model calls), --compare RUN_A RUN_B.
                     Components: TOOLREVIEW_CLASSIFIER_URL/_MODEL,
                     TOOLREVIEW_RESOLVER_URL/_MODEL.
  hook               the Codex hook entry point (reads the event on stdin).
  version            print this script's sha256.

Config:            $TOOLREVIEW_CONFIG
Cache:             $CACHE_ROOT (last $KEEP versions)
USAGE
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
  hook)
    v=$(version)
    d=$(code_dir "$v")
    export TOOLREVIEW_STATE_DIR="$STATE_DIR" TOOLREVIEW_VERSION="$v" \
      TOOLREVIEW_ENFORCEMENT_PATHS="$(codex_home)/config.toml:$TOOLREVIEW_CONFIG:$SELF:$LINK:$CACHE_ROOT"
    exec python3 "$d/entry.py"
    ;;
  install)
    proj=$(pwd -P)
    [ "${1:-}" = "--force" ] && force=1 || force=0
    [ -x "$LINK" ] && [ "$(readlink -f "$LINK")" = "$SELF" ] || die "$LINK must link to $SELF first: ln -sfn $SELF $LINK"
    if [ -f "$proj/.codex/hooks.json" ] && ! ours "$proj" && [ $force = 0 ]; then
      die "$proj/.codex/hooks.json exists and is not ours; inspect it, then rerun with --force to replace it"
    fi
    say "running tests"; run_tests || die "tests failed; nothing installed"
    say "checking the configuration"
    python3 "$(code_dir "$(version)")/config.py" show --check >&2 || die "the classifier or resolver is not usable; fix $TOOLREVIEW_CONFIG (see: $NAME config --check); nothing installed"
    mkdir -p "$proj/$STATE_DIR" "$proj/.codex"
    asset hooks.json | sed "s#@HOOK_COMMAND@#$HOOK_COMMAND#g" > "$proj/.codex/hooks.json"
    trust install "$proj"
    say "installed in $proj (state: $STATE_DIR/, version $(version | cut -c1-12))"
    [ -d "$proj/.git" ] || say "note: not a git repo, so start Codex in this exact folder; Codex finds .codex/ in subfolders only inside git repos"
    ;;
  uninstall)
    proj=$(pwd -P)
    ours "$proj" || die "no $NAME hooks in $proj/.codex/hooks.json"
    trust uninstall "$proj"
    rm -f "$proj/.codex/hooks.json"; rmdir "$proj/.codex" 2>/dev/null || true
    if [ "${1:-}" = "--purge" ]; then rm -rf "${proj:?}/$STATE_DIR"; say "deleted $STATE_DIR/"; fi
    say "uninstalled from $proj"
    ;;
  status)
    proj=$(pwd -P)
    echo "script:  $SELF"
    echo "version: $(version)"
    echo "cache:   $(ls -1 "$CACHE_ROOT" 2>/dev/null | wc -l) of $KEEP versions in $CACHE_ROOT"
    if ours "$proj"; then
      echo "here:    installed ($STATE_DIR/ $( [ -d "$proj/$STATE_DIR" ] && echo present || echo MISSING ))"
      trust status "$proj"
    else
      echo "here:    not installed in $proj"
    fi
    ;;
  test) run_tests && say "all tests passed" ;;
  config) exec python3 "$(code_dir "$(version)")/config.py" show "$@" ;;
  eval)
    v=$(version)
    d=$(code_dir "$v")
    export TOOLREVIEW_VERSION="$v" TOOLREVIEW_CODE_POLICY=1 \
      TOOLREVIEW_ENFORCEMENT_PATHS="$(codex_home)/config.toml:$TOOLREVIEW_CONFIG:$SELF:$LINK:$CACHE_ROOT"
    exec python3 "$d/eval.py" "$@"
    ;;
  version) version ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
exit

