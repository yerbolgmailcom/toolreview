            learn = os.environ.get("TOOLREVIEW_LEARN", "both")
            if hasattr(self.models, "extend") and ((decided == "allow" and learn in ("both", "allow"))
                                                   or (decided != "allow" and llm["decision"] == "deny" and learn == "both")):
                # toolreview: learn from the LLM in both directions (plain-text call, quotes checked):
                # after an allow, a scope bullet for that kind of work, so similar actions pass at L2;
                # after the LLM's own deny, a limit bullet if the user's words exclude that kind of
                # work, so similar actions are denied at L2. Each path keeps only its own kind of line.
                messages = [m["text"] for m in state["authority_evidence"]["sources"] if m["role"] in ("user", "goal") and m.get("text")]
                try:
                    if decided == "allow":
                        answer = bullets.only(self.models.extend(messages, scope_bullets, action), ("ADD SCOPE",))
                    else:
                        answer = bullets.only(self.models.extend(messages, scope_bullets, action, "denied", reason), ("ADD LIMIT",))
                    self.scope.update_bullets(event, answer, messages, "review")
                except Exception:
                    pass
            return finish(decided, reason, layer="L3")
        except Exception as exc:
            stage = getattr(self.models, "final_diagnostics", {}).get("stage", "classification/context")
            return finish("deny", f"Review could not complete at {stage} ({type(exc).__name__}); the action was not run. Retry after the review error is resolved.", layer="error", error=type(exc).__name__)
