        if text is not None:
            (self.dir / "config.toml").write_text(text)
        return config.load(refresh=True)
    def test_defaults_without_a_file(self):
        cfg, sources = self.load()
        self.assertEqual(cfg["classifier"]["url"], "https://api.typesafe.ai/v1/systemone")
        self.assertIsNone(cfg["resolver"]["url"])
        self.assertEqual(cfg["codex"]["home"], str(self.dir / ".codex"))
        self.assertEqual(sources["classifier.model"], "default")
    def test_environment_beats_file_beats_default(self):
        os.environ["TOOLREVIEW_RESOLVER_MODEL"] = "from-env"
        cfg, sources = self.load('[resolver]\nurl = "http://x/v1/chat/completions"\nmodel = "from-file"\n')
        self.assertEqual((cfg["resolver"]["model"], sources["resolver.model"]), ("from-env", "env TOOLREVIEW_RESOLVER_MODEL"))
        self.assertEqual(sources["resolver.url"], "file")
    def test_unknown_keys_are_rejected(self):
        with self.assertRaises(ValueError):
            self.load('[resolver]\nurll = "typo"\n')
    def test_resolver_reuses_a_codex_provider(self):
        home = self.dir / "codex"; home.mkdir()
        (home / "config.toml").write_text('[model_providers.local]\nbase_url = "http://host:8084/v1/"\nenv_key = "LOCAL_KEY"\n')
        cfg, sources = self.load(f'[codex]\nhome = "{home}"\n[resolver]\ncodex_provider = "local"\nmodel = "m"\n')
        self.assertEqual(cfg["resolver"]["url"], "http://host:8084/v1/chat/completions")
        self.assertEqual(cfg["resolver"]["api_key_env"], "LOCAL_KEY")
        self.assertEqual(sources["resolver.url"], "codex provider local")
    def test_secret_from_env_then_command(self):
        self.load('[classifier]\napi_key_env = "MY_KEY"\napi_key_command = "printf from-command"\n')
        self.assertEqual(config.secret("classifier"), "from-command")
        os.environ["MY_KEY"] = "from-env"
        self.assertEqual(config.secret("classifier"), "from-env")

class TrustWriteTests(unittest.TestCase):
    def setUp(self):
        import contextlib, io, runpy, sys
        self.tmp = tempfile.TemporaryDirectory(); self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.path = self.root / "config.toml"
        args = ["trust.py", "status", str(self.root / "project"), str(self.root), "test hook"]
        with mock.patch.object(sys, "argv", args), contextlib.redirect_stdout(io.StringIO()):
            self.write = runpy.run_path(str(Path(__file__).with_name("trust.py")))["write"]

    def test_preserves_private_permissions(self):
        self.path.write_text('name = "old"\n'); self.path.chmod(0o600)
        self.write('name = "new"\n')
        self.assertEqual(self.path.stat().st_mode & 0o777, 0o600)
        self.assertEqual(self.path.read_text(), 'name = "new"\n')

    def test_new_config_is_private(self):
        self.write('name = "new"\n')
