        nonlocal remaining
        path = path.resolve()
        if not path.is_relative_to(sessions) or not path.is_file():
            raise ValueError('unavailable native transcript')
        size = path.stat().st_size
        if size > remaining: raise ValueError('native transcript byte limit')
        remaining -= size
        with path.open() as stream:
            rows = []
            for line in stream:
                if len(line.encode()) > 4*1024*1024: raise ValueError('native line limit')
                rows.append(json.loads(line))
        meta = rows[0] if rows else {}
        payload = meta.get('payload', {})
        if (meta.get('type') != 'session_meta' or payload.get('session_id', payload.get('id')) != session or
            str(Path(payload.get('cwd', '/')).resolve()) != launch_directory):
            raise ValueError('native transcript identity mismatch')
        return payload, rows[1:]

    def prefix_file(thread):
        # Resumed segments have a physical thread suffix but retain session_id.
        # An exact suffix distinguishes them from abandoned sibling segments.
        matches = []
        if base.safe_id(thread) != thread: return None
        for path in sessions.rglob('*.jsonl'):
            if not (path.stem == thread or path.stem.endswith('_'+thread) or path.stem.endswith('-'+thread)): continue
            if not path.resolve().is_relative_to(sessions): continue
            try:
                with path.open() as stream: meta = json.loads(stream.readline(4*1024*1024))
                p = meta.get('payload', {})
                if meta.get('type') == 'session_meta' and p.get('session_id', p.get('id')) == event['session_id']:
                    matches.append(path)
            except (OSError, ValueError): continue
        return matches[0] if len(matches) == 1 else None

    def visit(path, session, end=None):
        marker = (str(path.resolve()), end)
        if marker in seen or len(seen) >= 16: raise ValueError('native history link limit')
        seen.add(marker)
        meta, rows = entries(path, session)
        messages = []
        link = meta.get('history_base')
        if link:
            try:
                parent, boundary = link['thread_id'], link['end_ordinal_exclusive']
                if not isinstance(parent, str) or type(boundary) is not int or boundary < 0:
                    raise ValueError('invalid native history link')
                prefix = prefix_file(parent)
                if prefix is None: raise ValueError('native history prefix unavailable or ambiguous')
                messages += visit(prefix, session, min(boundary, end) if end is not None else boundary)
            except (OSError, ValueError, KeyError, TypeError) as exc:
                context['omissions'].append(str(exc))
        for row in rows:
            if end is not None:
                ordinal = row.get('ordinal')
                if type(ordinal) is not int: raise ValueError('linked history lacks native ordinals')
                if ordinal >= end: continue
            p = row.get('payload', {}); item = p.get('item', {})
            if row.get('type') != 'event_msg' or p.get('type') != 'item_completed' or p.get('thread_id') != session:
                continue
            role = {'UserMessage':'user', 'AgentMessage':'assistant'}.get(item.get('type'))
            if not role: continue
            if p.get('turn_id') == event['turn_id']:
                # Current request is supplied by UserPromptSubmit; nothing after
                # that request can be a previously user-approved proposal.
                break
            content = item.get('content', [])
            text = '\n'.join(c['text'] for c in content if isinstance(c, dict) and
                c.get('type') in ('text', 'Text') and isinstance(c.get('text'), str))
            if text: messages.append({'role':role, 'turn_id':p.get('turn_id'), 'text':text})
        return messages

    try:
        messages = visit(Path(event['transcript_path']), event['session_id'])
        context['turn_pairs'] = turn_pairs(messages)[-10:]
        pins=set()
        if review_root:
            path=Path(review_root)/'sessions'/base.safe_id(event['session_id'])/'authority-pins.json'
            if path.exists():
                saved=json.loads(path.read_text())
                pins={sid for sid in saved.get('source_ids',[]) if saved.get('source_turns',{}).get(sid)!=event['turn_id']}
        # Only retrieve pins from THIS native branch. Stored audit text cannot
        # reintroduce an abandoned/forked request. Keep all later user limits.
        indices=[i for i,m in enumerate(messages) if source_id(m) in pins]
        if pins-{source_id(messages[i]) for i in indices}:
            context['omissions'].append('Previously pinned authority is absent from this native branch.')
        required=set(indices)
        # A long tool/assistant-heavy planning turn must not evict its user prompt
        # before the first mutation has produced authority pins.
        required.update([i for i,m in enumerate(messages) if m['role']=='user'][-8:])
        if indices:
            required.update(i for i,m in enumerate(messages) if i>=min(indices) and m['role']=='user')
        kept = []
        candidates=[m for i,m in enumerate(messages) if i in required or i>=len(messages)-24]
        for message in reversed(candidates):
            if len(base.canonical([message, *kept])) > 128000:
                context['omissions'].append('older dialogue omitted at complete-message budget')
                break
            kept.insert(0, message)
        if len(candidates)<len(messages): context['unselected_older_messages']=len(messages)-len(candidates)
        context['messages'] = kept
    except (OSError, ValueError, KeyError, TypeError, IndexError) as exc:
        context['omissions'].append(str(exc))
    return redact_context(context)

def root_turn(event, state):
    """toolreview: Codex starts a new turn on its own to continue an interrupted one (for
    example after its server restarts). That turn gets no UserPromptSubmit; the native
    transcript's turn_context names it with root_turn_id. Host data, never actor input."""
    path = event.get('transcript_path')
    if not isinstance(path, str):
        return None
    path = Path(path).resolve()
    if not path.is_relative_to((Path(state) / 'sessions').resolve()) or not path.is_file() or path.stat().st_size > 64 * 1024 * 1024:
        return None
    root = None
    with path.open() as stream:
        for line in stream:
            if '"turn_context"' not in line or event['turn_id'] not in line:
                continue
            try:
                entry = json.loads(line)
            except ValueError:
                continue
            payload = entry.get('payload') or {}
            if entry.get('type') == 'turn_context' and payload.get('turn_id') == event['turn_id']:
                root = payload.get('root_turn_id')
    return root if isinstance(root, str) and root and root != event['turn_id'] else None

def filesystem_fact(path):
    path=Path(path); resolved=path.resolve()
    value={'path':str(path),'resolved_path':str(resolved)}
    try:
        stat=path.stat()
        value.update(exists=True,identity=f'{stat.st_dev}:{stat.st_ino}',symlink=path.is_symlink())
    except FileNotFoundError:
        value['exists']=False
    return value

def write_targets(event):
    """Conservative target extraction, not a shell effects classifier.

    Unknown/computed target shapes never establish workspace provenance. Shell
    cwd changes, expansions and opaque programs are still assessed by the model.
    """
    args=event.get('tool_input',{}); cwd=Path(event['cwd'])
    if not isinstance(args,dict):return [],False
    cwd=Path(args.get('workdir') or args.get('cwd') or cwd)
    if not cwd.is_absolute():cwd=Path(event['cwd'])/cwd
    command=args.get('command',args.get('cmd'))
    paths=[]
    if event.get('tool_name')=='apply_patch':
        if not isinstance(command,str):return [],False
        for line in command.splitlines():
            for prefix in ('*** Add File: ','*** Update File: ','*** Delete File: ','*** Move to: '):
                if line.startswith(prefix):paths.append(line[len(prefix):])
        if not paths:return [],False
    elif event.get('tool_name')=='Bash' and isinstance(command,str):
        # A single literal heredoc has a fixed target and no interpolated body.
        heredoc=re.fullmatch(r'''\s*cat\s+>\s*(?P<target>'[^']+'|"[^"$`]+"|[^\s$`<>;&|]+)\s*<<\s*(?P<quote>['"])(?P<end>[A-Za-z_]\w*)(?P=quote)\s*\n[\s\S]*\n(?P=end)\s*''',command)
        if heredoc:
            target=shlex.split(heredoc['target'])[0]
            resolved=Path(target) if Path(target).is_absolute() else cwd/target
            return [os.path.normpath(str(resolved))],True
        lexer=shlex.shlex(command,posix=True,punctuation_chars='<>;&|()')
        lexer.whitespace_split=True
        tokens=list(lexer)
        # Only simple fixed-cwd redirections. Complex grammar is NOT a proof.
        if re.search(r'\b(?:cd|pushd|popd)\b',command) or any(c in command for c in ('$', '`', '\n')):
            return [],False
        for i,token in enumerate(tokens):
            if token in ('>','>>'):
                if i+1>=len(tokens):return [],False
                target=tokens[i+1]
                if target=='/dev/null':continue  # Kernel output sink, not persistent user work.
                if target in ('&','|',';','>','<') or any(c in target for c in '*?{}[]~'):
                    return [],False
                paths.append(target)
            elif '>' in token:return [],False
        if not paths:return [],False
    else:
        # Generic tool protocols require an independent native contract. A field
        # named "path" alone cannot prove that a tool writes only that path.
        return [],False
    normalized=[]
    for path in paths:
        target=Path(path)
        if not target.is_absolute():target=cwd/target
        normalized.append(os.path.normpath(str(target)))
    return sorted(set(normalized)),True

def execution_result(event):
    value=event.get('tool_response')
    if isinstance(value,str):
        if event.get('tool_name')=='Bash':
            return {'exit_code':None,'output':value}  # Raw stdout, including JSON-shaped stdout.
        try:value=json.loads(value)
        except json.JSONDecodeError:
            if event.get('tool_name')=='apply_patch' and value.startswith('Success. Updated the following files:'):
                return {'exit_code':0,'output':value}
            # Bash PostToolUse may be raw stdout: even text resembling a native
            # envelope is not independent execution-status evidence.
            return {'exit_code':None,'output':value}
    if isinstance(value,dict):
        code=value.get('exit_code')
        if type(code) is not int or value.get('timed_out'):code=None
        return {'exit_code':code,'stdout':value.get('stdout',''),'stderr':value.get('stderr','')}
    return {'exit_code':None,'output':value}

class ReviewAdapter:
    def __init__(self,root,models=None,state=STATE):
        self.root=Path(root).resolve(); self.state=Path(state)
        # toolreview: policy from the code folder when run by the script (see judge.py).
        policy=(Path(__file__).resolve().parent if os.environ.get('TOOLREVIEW_CODE_POLICY') else self.root)/'base-schema.json'
        self.policy=json.loads(policy.read_text())
        # Reuse baseline validation (thresholds/questions must remain valid).
        base.Judge(self.root,models=object())
        self.scope=Scope(self.root,self.root.parent)
        self.models=models or Models()
        if hasattr(self.models,'settings'):self.models.settings=self.policy

    def sync_goal(self,event):
        session=event['session_id']; path=self.root/'sessions'/base.safe_id(session)/'goal-state.json'
        if path.exists():self.scope.set_goal(json.loads(path.read_text()))
        database=self.state/'goals_1.sqlite'
        goal=None
        if database.exists():
            with closing(sqlite3.connect(f'file:{database}?mode=ro',uri=True,timeout=2)) as connection:
                row=connection.execute('SELECT goal_id,objective,status FROM thread_goals WHERE thread_id=?',(session,)).fetchone()
            if row:
                identifier,objective,status=row
                mapped='active' if status=='active' else 'complete' if status=='complete' else 'paused'
                goal={'id':identifier,'objective':objective,'status':mapped,'session_id':session,
                      'launch_directory':self.scope.launch_directory}
        previous=self.scope.goal
        if previous and previous['status'] in ('active','paused') and (goal is None or
            goal['id']!=previous['id'] or goal['status']=='complete'):
            self.scope.finish_goal(event,'complete' if goal and goal['status']=='complete' else 'cancelled')
        self.scope.set_goal(goal)
        path.parent.mkdir(parents=True,exist_ok=True,mode=0o700)
        base.atomic_replace(path,goal)

    def scope_answer(self,event,prompt):
        """toolreview: the user's message after a scope proposal approves all or part of it, or
        not; any answer consumes the proposal. An approved scope is kept at the session level and
        copied into every later turn's bullets until a new approval replaces it."""
        pending=self.scope.read_session(event,'pending-scope.json')
        if pending:
            parsed=pending.get('parsed')
            record={'proposal':pending['text'],'approval':prompt,'turn_id':event['turn_id']}
            if parsed:
                try:
                    scope=approved_items(self.models,pending['text'],parsed['scope'],prompt)
                except Exception as exc:   # classifier unavailable: nothing approved; the LLM path remains
                    scope=[];record['error']=type(exc).__name__
                if scope:
                    record['approved']={'scope':scope,'limits':parsed['limits']}
            else:
                record['needs_conversion']=True   # one LLM call in the background worker, then Jev per item
            if record.get('approved') or record.get('needs_conversion'):
                self.scope.write_session(event,'approved-scope.json',record)
            self.scope.append(event,'scope_answer',{k:v for k,v in record.items() if k!='proposal'})
            self.scope.write_session(event,'pending-scope.json',None)
        approved=self.scope.read_session(event,'approved-scope.json')
        if approved and approved.get('approved'):
            self.scope.add_approved_scope(event,approved['approved'],approved['proposal'],approved['approval'])

    def scope_at_stop(self,event):
        """toolreview: in a delegated turn without an approved scope, the agent's final message
        should be a scope proposal. Store it if it parses; nudge once if malformed; after that,
        keep it for one LLM conversion at approval time."""
        records=self.scope.records(event)
        asked=any(r['kind']=='review' and r['data'].get('needs_scope') for r in records)
        if not (self.scope.delegated(event) or asked) or bullets.has_approved_scope(self.scope.bullets(event)):
            return None
        text=event.get('last_assistant_message') or ''
        parsed=scope_proposal.parse(text)
        if parsed:
            self.scope.write_session(event,'pending-scope.json',{'text':text,'parsed':parsed,'turn_id':event['turn_id']})
            return None
        if not (asked or scope_proposal.intends_proposal(text)):
            return None
        if not event.get('stop_hook_active'):
            self.scope.append(event,'scope_nudge',{})
            return {'decision':'block','reason':scope_proposal.NUDGE}
        self.scope.write_session(event,'pending-scope.json',{'text':text,'parsed':None,'turn_id':event['turn_id']})
        return None

    def start_bullets(self,event):
        """toolreview: write the task bullets in the background when a prompt arrives, so
        the hook returns at once. Only with the real models (never in tests)."""
        if type(self.models) is not Models:return
        try:
            fd,path=tempfile.mkstemp(prefix='.bullets-event-',suffix='.json',dir=self.root)
            os.write(fd,json.dumps(event).encode());os.close(fd)
            subprocess.Popen([sys.executable,str(Path(__file__).resolve().parent/'bullet_worker.py'),str(self.root),path],
                             stdin=subprocess.DEVNULL,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,start_new_session=True)
        except OSError:
            pass

    def reconcile_outcomes(self,event):
        """Append missing statuses from matching native completion records.

        PostToolUse can run before completion is flushed to the transcript.
        Revisit pending outcomes before subsequent reviews. Never use stdout,
        acting-model messages or call arguments as completion evidence.
        """
        records=self.scope.records(event)
        corrected={r['data'].get('corrects_outcome_id') for r in records if r['kind']=='outcome'}
        pending=[r for r in records if r['kind']=='outcome' and r['data'].get('exit_code') is None and r['id'] not in corrected]
        if not pending:return
        transcript=event.get('transcript_path')
        if not isinstance(transcript,str):return
        path=Path(transcript).resolve()
        if not path.is_relative_to((self.state/'sessions').resolve()) or not path.is_file():return
        # Explicit parsing budget. Missing/over-budget evidence remains unknown.
        if path.stat().st_size>64*1024*1024:return
        with path.open() as stream:
            first=stream.readline(4*1024*1024)
            try:meta=json.loads(first)
            except (ValueError,TypeError):return
            payload=meta.get('payload',{})
            if meta.get('type')!='session_meta' or payload.get('session_id',payload.get('id'))!=event['session_id']:return
            if str(Path(payload.get('cwd','/')).resolve())!=self.scope.launch_directory:return
            completions={}
            for line in stream:
                if len(line)>4*1024*1024:return
                try:entry=json.loads(line)
                except (ValueError,TypeError):return
                payload=entry.get('payload',{});item=payload.get('item',{})
                if (entry.get('type')!='event_msg' or payload.get('type')!='item_completed' or
                    payload.get('thread_id')!=event['session_id'] or item.get('type')!='CommandExecution' or
                    item.get('status')!='completed' or type(item.get('exit_code')) is not int):continue
                completions[(payload.get('turn_id'),item.get('id'))]=item
        for outcome in pending:
            data=outcome['data'];turn=data.get('execution_turn_id');tool=data.get('tool_use_id')
            item=completions.get((turn,tool))
            if not item:continue
            prior=next((r for r in reversed(records) if r['kind']=='review' and r['data'].get('route')=='allow' and
                r['data'].get('execution_turn_id')==turn and r['data'].get('tool_use_id')==tool),None)
            if not prior:continue
            action=prior['data']['state']['proposed_action'];args=action.get('arguments',{})
            command=args.get('command',args.get('cmd')) if isinstance(args,dict) else None
            argv=item.get('command')
            if action.get('tool_name')!='Bash' or not isinstance(command,str) or not isinstance(argv,list) or len(argv)<3 or argv[-2:]!=['-lc',command]:continue
            self.scope.append({**event,'turn_id':turn},'outcome',{**data,'exit_code':item['exit_code'],
                'corrects_outcome_id':outcome['id'],'completion_source':'native session item_completed; exact session/turn/tool/command match'})

    def handle(self,event):
        self.sync_goal(event)
        name=event['hook_event_name']
        if name!='UserPromptSubmit' and not self.scope.request(event):
            # toolreview: a continuation turn Codex started itself belongs to its root turn
            # (same task, records and bullets), if that turn holds the user's prompt.
            root=root_turn(event,self.state)
            if root and self.scope.request({**event,'turn_id':root}):
                event={**event,'turn_id':root,'continued_turn_id':event['turn_id']}
        if name=='UserPromptSubmit':
            prompt=redact_context(event.get('prompt',''))
            self.scope.prompt(event,prompt)
            self.scope_answer(event,prompt)
            self.start_bullets(event)
            # toolreview: a delegated task ("$skill ...", "do what requirements.md says") may only
            # be explored until the user approves a scope; tell the agent the format up front.
            cwd=event.get('cwd') or self.scope.launch_directory
            refs=scope_proposal.delegated(prompt,cwd,(Path.home()/'.agents'/'skills',self.state/'skills',Path(cwd)/'.codex'/'skills'))
            if refs:
                self.scope.append(event,'delegated',{'refs':refs})
                return {'hookSpecificOutput':{'hookEventName':'UserPromptSubmit','additionalContext':scope_proposal.INSTRUCTION}}
            return {}
        if name=='PostToolUse':
            result=execution_result(event)
            execution_scope=self.scope.execution_scope(event)
            records=self.scope.records(event,scope_path=execution_scope)
            prior=next((r for r in reversed(records) if r['kind']=='review' and
                r['data'].get('execution_turn_id')==event['turn_id'] and
                r['data'].get('tool_use_id')==event.get('tool_use_id')),None)
            targets=prior['data']['state'].get('write_targets',[]) if prior and prior['data']['route']=='allow' else []
            assessment=prior['data'] if prior else {}
            secret_clear=(assessment.get('answers',{}).get('secrets',{}).get('choice')=='no' and
                          (assessment.get('llm') is None or assessment['llm'].get('secrets')=='no'))
            if not secret_clear:
                result={**result,'stdout':'[WITHHELD: potentially credential-bearing output]',
                        'stderr':'[WITHHELD]','output':'[WITHHELD]'}
            truncated={k:len(v)-24000 for k,v in result.items() if isinstance(v,str) and len(v)>24000}
            result=base.redact(result)
            if truncated:result['output_truncation_characters']=truncated
            result.update(tool_use_id=event.get('tool_use_id'),filesystem_after=[filesystem_fact(p) for p in targets],
                          source='native PostToolUse plus local stat; no simulated outcomes')
            self.scope.append(event,'outcome',result,scope_path=execution_scope);return {}
        if name in ('Stop','Interrupt'):
            if name=='Stop':
                blocked=self.scope_at_stop(event)
                if blocked:return blocked
            self.scope.stop(event);return {}
        if name!='PreToolUse':raise ValueError('unsupported hook event')
        self.scope.native_conversation = conversation_context(event, self.state, self.scope.launch_directory, self.scope.root)
        self.reconcile_outcomes(event)
        targets,complete=write_targets(event)
        facts=[filesystem_fact(p) for p in targets]
        action={'tool_name':event['tool_name'],'arguments':event.get('tool_input',{}),'cwd':event['cwd']}
        result=Arbiter(self.scope,self.models).review(event,action,facts,targets,complete)
        if result['route']=='allow':return {}
        # toolreview: no human step; the reason says what permission to ask the user for.
        return {'hookSpecificOutput':{'hookEventName':name,'permissionDecision':'deny',
            'permissionDecisionReason':'Action denied. '+result['actor_reason']+' Do not bypass review. Retry only with corrected scope or new user authorization.'}}
