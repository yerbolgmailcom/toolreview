#=== ASSET trust.py ===
"""toolreview trust helper: register, check or remove the trust Codex
needs to run a project's hooks.

Codex runs hooks from <project>/.codex/hooks.json only when the project is
trusted and each hook's exact definition was trusted (a hash in config.toml).
The hashes come from Codex itself (app-server hooks/list), never computed here.

usage: trust.py install|uninstall|status <project> <codex_home> <hook_command>
"""
import json, os, re, selectors, shutil, stat, subprocess, sys, tempfile, time, tomllib
from pathlib import Path

action, project, home, command = sys.argv[1], Path(sys.argv[2]).resolve(), Path(sys.argv[3]), sys.argv[4]
config = home / "config.toml"
hooks_file = str(project / ".codex" / "hooks.json")


def codex_hooks():
    codex = shutil.which("codex")
    if not codex:
        raise SystemExit("codex CLI not found on PATH")
    proc = subprocess.Popen([codex, "app-server", "-c", "features.hooks=true"], env={**os.environ, "CODEX_HOME": str(home)},
                            stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)

    def send(obj):
        proc.stdin.write(json.dumps(obj) + "\n")
        proc.stdin.flush()

    def receive(identifier):
        selector = selectors.DefaultSelector()
        selector.register(proc.stdout, selectors.EVENT_READ)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline:
            if selector.select(timeout=1):
                line = proc.stdout.readline()
                if not line:
                    raise SystemExit("codex app-server stopped")
                data = json.loads(line)
                if data.get("id") == identifier:
                    if "error" in data:
                        raise SystemExit("codex app-server: " + str(data["error"]))
                    return data["result"]
        raise SystemExit("codex app-server did not answer")

    try:
        send({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "toolreview", "version": "1"},
                                                            "capabilities": {"experimentalApi": True}}})
        receive(1)
        send({"method": "initialized", "params": {}})
        send({"id": 2, "method": "hooks/list", "params": {"cwds": [str(project)]}})
        result = receive(2)
    finally:
        proc.terminate()
        proc.wait(timeout=10)
    return [h for entry in result["data"] for h in entry["hooks"]
            if h.get("sourcePath") == hooks_file and h.get("command") == command]


def read():
    return config.read_text() if config.exists() else ""


def write(text):
    tomllib.loads(text)  # never leave an invalid config behind
    # Preserve a managed symlink and the target's permission bits. A unique
    # temporary file avoids collisions and starts private even under umask 022.
    target = config.resolve()
    mode = stat.S_IMODE(target.stat().st_mode) if target.exists() else 0o600
    fd, name = tempfile.mkstemp(prefix=".toolreview-config-", dir=target.parent)
    tmp = Path(name)
    try:
        with os.fdopen(fd, "w") as stream:
            stream.write(text)
            stream.flush()
            os.fchmod(stream.fileno(), mode)
            os.fsync(stream.fileno())
        tmp.replace(target)
    finally:
        tmp.unlink(missing_ok=True)


def without_state(text):
    pattern = r'\[hooks\.state\."' + re.escape(hooks_file) + r':[^"]*"\]\n(?:[^\[\n][^\n]*\n|\n)*'
    return re.sub(pattern, "", text)


def trusted_project(text):
    return tomllib.loads(text).get("projects", {}).get(str(project), {}).get("trust_level") == "trusted"


if action == "install":
    text = read()
    if not trusted_project(text):
        text = text.rstrip("\n") + f'\n\n[projects."{project}"]\ntrust_level = "trusted"\n'
        write(text)
    hooks = codex_hooks()
    if not hooks:
        raise SystemExit("Codex lists none of this project's hooks; is .codex/hooks.json in place?")
    text = without_state(read()).rstrip("\n") + "\n"
    for hook in hooks:
        text += f'\n[hooks.state.{json.dumps(hook["key"])}]\ntrusted_hash = {json.dumps(hook["currentHash"])}\nenabled = true\n'
    write(text)
    left = [h["key"].rsplit(":", 2)[0].rsplit(":", 1)[-1] for h in codex_hooks() if h.get("trustStatus") != "trusted"]
    if left:
        raise SystemExit("still untrusted after registration: " + ", ".join(left))
    print(f"trusted {len(hooks)} hooks for {project} in {config}")
elif action == "uninstall":
    write(without_state(read()))
    print(f"removed hook trust for {project} (project trust entry kept)")
elif action == "status":
    text = read()
    hooks = codex_hooks() if trusted_project(text) else []
    states = sorted({h.get("trustStatus") for h in hooks})
    print(f"project trusted: {trusted_project(text)}; hooks seen by Codex: {len(hooks)}; trust: {', '.join(states) or 'n/a'}")
else:
    raise SystemExit(__doc__)
