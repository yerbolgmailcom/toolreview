def answer(label, confidence=1., probability=1.):
    others = [x for x in j.CHOICES if x != label]
    return {"type": "choice", "choice": label, "confidence": confidence,
            "probabilities": {label: probability, **{x: (1-probability)/2 for x in others}}}

class Fake:
    def __init__(self):
        self.labels = {"no_state_change": "yes", "secrets": "no", "tampering": "no",
                       "authorized": "uncertain", "destructive": "uncertain"}
        self.calls = []
        self.llm_calls = 0
        self.value = {"decision": "escalate", "reason": "The command effects cannot be established.",
                      "effects": "unknown", "secrets": "uncertain", "tampering": "no",
                      "authorized": "uncertain", "irreversible": "uncertain",
                      "can_make_rule": False, "turn_recipe": None}
        self.applies, self.restriction = "yes", "no"
        self.confidence, self.probability = 1., 1.
    def jev(self, state, questions, model):
        self.calls.append(copy.deepcopy((state, questions)))
        labels = {k: self.labels.get(k, "yes") for k in questions}
        if "applies" in labels:
            labels["applies"] = self.applies
        if "restriction" in labels:
            labels["restriction"] = self.restriction
        return {"model": model, "answers": {k: answer(v, self.confidence, self.probability) for k,v in labels.items()}}
    def llm(self, state, answers):
        self.llm_calls += 1
        self.llm_state = copy.deepcopy(state)
        return self.value

