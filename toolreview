            fcntl.flock(lock, fcntl.LOCK_EX)
            current = self.bullets(event)
            updated = bullets.add_approved(current, approved, proposal, approval)
            if updated != current:
                self.append(event, "bullets_revision", {"source": "approved scope", "approved": approved,
                            "approval": approval, "bullets": updated}, "bullet_versions")
                base.atomic_replace(path / "bullets.json", updated)
            return updated
    def update_bullets(self, event, answer, messages, source, digest=None):
        import fcntl
        path = self.resolve(event)
        path.mkdir(parents=True, exist_ok=True)
        with open(path / "bullets.lock", "w") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            current = self.bullets(event)
            updated, rejected = bullets.apply(current, answer, messages, source)
            if digest is not None:
                updated["messages_digest"] = digest
            if updated != current:
                self.append(event, "bullets_revision", {"source": source, "answer": answer, "rejected": rejected,
                            "bullets": updated}, "bullet_versions")
                base.atomic_replace(path / "bullets.json", updated)
