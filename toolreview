RUNTIME = re.compile(r"(?i)(?:\.toolreview(?:[/\\]|\b)|\.local[/\\]share[/\\]codex-local|\.codex[/\\](?:config\.toml|hooks\.json)|features\.hooks|dangerously-bypass-approvals-and-sandbox)")
LLM_BYTES = 262144
# toolreview: appended on the one retry after a malformed answer. At temperature 0 a plain
