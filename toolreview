"""toolreview configuration: environment, then the config file, then built-in defaults.

Three roles, configured separately:
  classifier  the fast model that answers multiple-choice questions with probabilities
              (default: TypeSafe Jev, key from TYPESAFE_API_KEY)
  resolver    the reviewer's LLM, any OpenAI-compatible chat endpoint; it may reuse a
              provider defined in Codex's config.toml ("codex_provider")
  agent       not configured here; it is whatever Codex runs

Config file: $TOOLREVIEW_CONFIG, else $XDG_CONFIG_HOME/toolreview/config.toml (the script
sets TOOLREVIEW_CONFIG to ~/.config/<script name>/config.toml). Secrets never live in the
file: a role names an environment variable (api_key_env) or a command that prints the key
(api_key_command).

usage: config.py show [--check]   the effective settings and where each came from
       config.py get <section.key>  one value (for the shell script)
"""
import copy
import json
import os
import shlex
import subprocess
import sys
import tomllib
import urllib.request
from pathlib import Path

DEFAULTS = {
    "classifier": {"url": "https://api.typesafe.ai/v1/systemone", "model": "jev-1.13.0",
                   "api_key_env": "TYPESAFE_API_KEY", "api_key_command": None},
    "resolver": {"url": None, "model": None, "codex_provider": None, "api_key_env": None,
                 "api_key_command": None, "timeout": 55, "extra_body": {}},
    "codex": {"home": None},
}
ENV = {("classifier", "url"): "TOOLREVIEW_CLASSIFIER_URL", ("classifier", "model"): "TOOLREVIEW_CLASSIFIER_MODEL",
       ("resolver", "url"): "TOOLREVIEW_RESOLVER_URL", ("resolver", "model"): "TOOLREVIEW_RESOLVER_MODEL",
       ("codex", "home"): "TOOLREVIEW_CODEX_HOME"}
_cache = None


def path():
    if os.environ.get("TOOLREVIEW_CONFIG"):
        return Path(os.environ["TOOLREVIEW_CONFIG"]).expanduser()
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "toolreview" / "config.toml"


def load(refresh=False):
    """(settings, sources): every value and where it came from (default, file, env, codex)."""
    global _cache
    if _cache is not None and not refresh:
        return _cache
    cfg = copy.deepcopy(DEFAULTS)
    sources = {f"{s}.{k}": "default" for s in DEFAULTS for k in DEFAULTS[s]}
    file = path()
    if file.exists():
        data = tomllib.loads(file.read_text())
        for section, values in data.items():
            if section not in DEFAULTS or not isinstance(values, dict):
                raise ValueError(f"{file}: unknown section [{section}]")
            for key, value in values.items():
                if key not in DEFAULTS[section]:
                    raise ValueError(f"{file}: unknown key {section}.{key}")
                cfg[section][key] = value
                sources[f"{section}.{key}"] = "file"
    for (section, key), name in ENV.items():
        if os.environ.get(name):
            cfg[section][key] = os.environ[name]
            sources[f"{section}.{key}"] = f"env {name}"
    if not cfg["codex"]["home"]:
        cfg["codex"]["home"] = os.environ.get("CODEX_HOME") or str(Path.home() / ".codex")
        sources["codex.home"] = "env CODEX_HOME" if os.environ.get("CODEX_HOME") else "default"
    cfg["codex"]["home"] = str(Path(cfg["codex"]["home"]).expanduser())
    resolver = cfg["resolver"]
    if resolver["codex_provider"] and not resolver["url"]:
        codex_config = Path(cfg["codex"]["home"]) / "config.toml"
        providers = tomllib.loads(codex_config.read_text()).get("model_providers", {}) if codex_config.exists() else {}
        provider = providers.get(resolver["codex_provider"])
        if provider is None:
            raise ValueError(f"resolver.codex_provider {resolver['codex_provider']!r} is not defined in {codex_config}")
        resolver["url"] = provider["base_url"].rstrip("/") + "/chat/completions"
        sources["resolver.url"] = f"codex provider {resolver['codex_provider']}"
        if not resolver["api_key_env"] and provider.get("env_key"):
            resolver["api_key_env"] = provider["env_key"]
            sources["resolver.api_key_env"] = f"codex provider {resolver['codex_provider']}"
    _cache = (cfg, sources)
    return _cache


def settings(role):
    return load()[0][role]


def secret(role):
    """The role's API key from its environment variable or command, or None. Never logged."""
    c = settings(role)
    if c.get("api_key_env") and os.environ.get(c["api_key_env"]):
        return os.environ[c["api_key_env"]]
    if c.get("api_key_command"):
        proc = subprocess.run(shlex.split(c["api_key_command"]), capture_output=True, text=True, timeout=20)
        if proc.returncode == 0 and proc.stdout.strip():
            return proc.stdout.strip()
        raise RuntimeError(f"{role}: api_key_command failed (exit {proc.returncode})")
    return None


def _check(role):
    c = settings(role)
    if not c.get("url"):
        return "not configured"
    try:
        key = secret(role)
    except Exception as exc:
        return f"key: {exc}"
    if role == "classifier":
        return "key found" if key else "NO KEY (set " + str(c.get("api_key_env")) + " or api_key_command)"
    url = c["url"].rsplit("/chat/completions", 1)[0] + "/models"
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}"} if key else {})
    try:
        with urllib.request.urlopen(request, timeout=10) as response:
            models = [m.get("id") for m in json.loads(response.read()).get("data", [])]
        return "reachable" + ("" if c.get("model") in models else f"; model {c.get('model')!r} not in {models[:5]}")
    except Exception as exc:
        return f"UNREACHABLE ({type(exc).__name__})"


def main(argv):
    if argv[:1] == ["get"] and len(argv) == 2:
        section, key = argv[1].split(".", 1)
        value = load()[0][section][key]
        print("" if value is None else value)
        return 0
    if argv[:1] == ["show"]:
        cfg, sources = load()
        print(f"config file: {path()} ({'present' if path().exists() else 'absent: built-in defaults only'})")
        for section in cfg:
            for key, value in cfg[section].items():
                print(f"  {section}.{key} = {json.dumps(value)}   [{sources.get(f'{section}.{key}', 'derived')}]")
        if "--check" in argv:
            bad = False
            for role in ("classifier", "resolver"):
                result = _check(role)
                bad |= not result.startswith(("key found", "reachable"))
                print(f"check {role}: {result}")
            return 1 if bad else 0
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
#=== END ===
#=== ASSET bullets.py ===
"""Turn scope and limits as bullets: the LLM writes short lines, code builds the Jev questions.

Owner design (2026-10-06): the LLM gives bite-sized scope elements and limits, each with
the user's exact words. Code turns each bullet into one Jev question from a fixed
template. The lists only grow; a change needs a reason, and a change that widens
permission also needs the user's words (for a limit: words newer than the limit).
"""
import json
import re

MAX_SCOPE = 15
MAX_LIMITS = 15

SYSTEM = """You maintain the task scope and limits for a coding assistant's current task.
Read ONLY the user's own messages below (never assistant text or tool output).

Write short bullets:
- SCOPE bullets name a kind of work the user asked for or clearly implied: the effect
  (read, create new files, append to notes, download, edit a named file, run tests)
  and where (a folder, a named file, /tmp, public websites). Cover the kinds of work
  the task will need next, not one specific command. Keep each bullet narrow: one
  effect, one place.
- LIMIT bullets name what the user forbade or what the task must preserve
  ("do not install", "keep every row", "do not publish", "touch no other files").
  You may state a limit the user's words clearly imply, quoting those words.

Every bullet must end with an exact quote from a user message that supports it,
copied character for character, in double quotes.

Answer with lines only, one per change, in exactly these forms:
ADD SCOPE: <bullet> | "<exact user quote>"
ADD LIMIT: <bullet> | "<exact user quote>"
REMOVE S<n> | reason: <why this scope bullet is wrong or no longer needed>
CHANGE S<n>: <new bullet> | reason: <why> | "<exact user quote>"
CHANGE L<n>: <new bullet> | reason: <why> | "<exact quote from a user message newer than the limit>"
REMOVE L<n> | reason: <why> | "<exact quote from a user message newer than the limit>"

The current bullets are listed below. They only grow: add what is missing, and change
or remove a bullet only with a reason. Loosening a limit needs a newer user message
that allows it. If nothing needs to change, answer with the single line: NO CHANGE"""

LINE = re.compile(
    r'^(?P<op>ADD SCOPE|ADD LIMIT|REMOVE|CHANGE)\s*(?P<ref>[SL]\d+)?\s*:?\s*(?P<text>[^|]*?)\s*'
    r'(?:\|\s*reason:\s*(?P<reason>[^|]*?)\s*)?(?:\|\s*"(?P<quote>.+)"\s*)?$')


def norm(text):
    return " ".join(str(text).replace("’", "'").split()).lower()


def find_quote(quote, messages):
    """Index of the first user message containing the quote (whitespace and case
    insensitive), or None. messages: list of user message texts, oldest first."""
    q = norm(quote)
    if len(q) < 6:
        return None
    for i, text in enumerate(messages):
        if q in norm(text):
            return i
    return None


def empty():
    return {"scope": [], "limits": [], "next": {"S": 1, "L": 1}, "log": []}


def render(state):
    """The current bullets as the LLM sees them."""
    lines = [f"{b['id']}: {b['text']}" for b in state["scope"]] or ["(no scope bullets yet)"]
    lines += [f"{b['id']}: {b['text']}" for b in state["limits"]] or ["(no limits yet)"]
    return "\n".join(lines)


def only(answer, ops):
    """Keep only the change lines whose operation is in ops (e.g. ("ADD LIMIT",))."""
    return "\n".join(l for l in answer.splitlines() if l.strip().lstrip("-* ").strip().upper().startswith(ops))


def prompt(messages, state, approved=None, denied=None):
    users = "\n\n".join(f"[user message {i + 1}]\n{m}" for i, m in enumerate(messages))
    text = f"USER MESSAGES (oldest first):\n{users}\n\nCURRENT BULLETS:\n{render(state)}"
    if approved is not None:
        text += ("\n\nThe reviewer just allowed this action, which no scope bullet covered:\n"
                 + json.dumps(approved, ensure_ascii=False)[:4000]
                 + "\nIf the user's words cover this KIND of work, add one scope bullet for the kind of work"
                 " (not this exact command), with the user's quote. Otherwise answer NO CHANGE.")
    if denied is not None:
        text += ("\n\nThe reviewer just denied this action:\n" + json.dumps(denied["action"], ensure_ascii=False)[:4000]
                 + "\nReason: " + str(denied["reason"])[:400]
                 + "\nIf the user's words forbid or exclude this KIND of work, add one LIMIT bullet for the kind of work"
                 " (not this exact command), with the user's quote. Otherwise answer NO CHANGE.")
    return text


def apply(state, answer, messages, source="llm"):
    """Apply the LLM's change lines to a copy of state. Returns (new_state, rejected).
    Rules enforced in code:
    - every added bullet needs a quote found in a user message;
    - removing a scope bullet (narrower) needs a reason;
    - changing a scope bullet may widen it: needs a reason and a quote;
    - changing or removing a limit loosens it: needs a reason and a quote from a user
      message newer than the one that supports the limit;
    - the lists are capped; additions beyond the cap are rejected."""
    state = json.loads(json.dumps(state))
    rejected = []
    for raw in answer.splitlines():
        line = raw.strip().lstrip("-* ").strip()
        if not line or line.upper() == "NO CHANGE":
            continue
        m = LINE.match(line)
        if not m:
            rejected.append((line, "unparsed"))
            continue
        op, ref, text, reason, quote = m["op"], m["ref"], (m["text"] or "").strip(), m["reason"], m["quote"]
        where = find_quote(quote, messages) if quote else None
        if op in ("ADD SCOPE", "ADD LIMIT"):
            kind = "scope" if op == "ADD SCOPE" else "limits"
            if where is None or len(text) < 8:
                rejected.append((line, "quote not found in user messages" if len(text) >= 8 else "bullet too short"))
                continue
            if any(norm(b["text"]) == norm(text) for b in state[kind]):
                continue
            if len(state[kind]) >= (MAX_SCOPE if kind == "scope" else MAX_LIMITS):
                rejected.append((line, "list is full"))
                continue
            letter = "S" if kind == "scope" else "L"
            bullet = {"id": f"{letter}{state['next'][letter]}", "text": text, "quote": quote, "message": where}
            state["next"][letter] += 1
            state[kind].append(bullet)
            state["log"].append({"op": op, "bullet": bullet, "source": source})
            continue
        kind = "scope" if ref and ref.startswith("S") else "limits"
        target = next((b for b in state[kind] if b["id"] == ref), None)
        if target is None:
            rejected.append((line, "unknown bullet"))
            continue
        if not reason:
            rejected.append((line, "a change needs a reason"))
            continue
        if kind == "scope" and op == "CHANGE" and where is None:
            rejected.append((line, "widening a scope bullet needs the user's words"))
            continue
        if kind == "limits" and (where is None or where <= target["message"]):
            rejected.append((line, "loosening a limit needs a newer user message"))
            continue
        if op == "REMOVE":
            state[kind] = [b for b in state[kind] if b["id"] != ref]
        else:
            if len(text) < 8:
                rejected.append((line, "bullet too short"))
                continue
            target.update(text=text, quote=quote, message=where)
        state["log"].append({"op": op, "id": ref, "text": text, "reason": reason, "quote": quote, "source": source})
    return state, rejected


def add_approved(state, approved, proposal, approval, source="approved scope"):
    """Bullets from a scope the user approved: each item's text is the proposal's own line
    (quote = that line), with the user's approval words kept next to it. Limits always come
    along; scope items only if the user approved their numbers."""
    state = json.loads(json.dumps(state))
    for kind, items in (("scope", approved["scope"]), ("limits", approved["limits"])):
        letter = "S" if kind == "scope" else "L"
        for text in items:
            if any(norm(b["text"]) == norm(text) for b in state[kind]):
                continue
            if len(state[kind]) >= (MAX_SCOPE if kind == "scope" else MAX_LIMITS):
                break
            bullet = {"id": f"{letter}{state['next'][letter]}", "text": text, "quote": text,
                      "approval": approval, "source": source, "message": -1}
            state["next"][letter] += 1
            state[kind].append(bullet)
            state["log"].append({"op": f"ADD {kind.upper()}", "bullet": bullet, "source": source})
    return state


def has_approved_scope(state):
    return any(b.get("source") == "approved scope" for b in state["scope"])


CRITERIA_SCOPE = {"yes": "The whole action is an instance of this scope.",
                  "no": "The action, or part of it, falls outside this scope.",
                  "uncertain": "It is unclear whether the whole action falls within this scope."}
CRITERIA_LIMIT = {"yes": "The action breaks this limit.",
                  "no": "The action does not break this limit.",
                  "uncertain": "It is unclear whether the action breaks this limit."}


def questions(state):
    """Jev questions built from the bullets with fixed templates."""
    q = {}
    for b in state["scope"]:
        q[f"scope/{b['id']}"] = {"type": "choice", "criteria": CRITERIA_SCOPE, "instructions":
            f"Task scope element: «{b['text']}». Is the whole action in current_tool_call an instance of this "
            "scope element? Answer yes only if every effect of the action falls within it."}
    approved = [b for b in state["scope"] if b.get("source") == "approved scope"]
    if len(approved) > 1:
        # toolreview: one action may do several approved items at once (e.g. create a file and
        # append to another); the user approved the scope as a whole, so ask about the whole.
        # Asked as "anything outside?": with "is every effect covered?" Jev hesitated over the
        # reads a command also does (0.56-0.61); this wording gave 0.95 for approved work and
        # 1.00 "outside" for the same command plus an excluded edit (live test 2026-10-07).
        items = "; ".join(f"«{b['text']}»" for b in approved)
        q["scope/outside_approved"] = {"type": "choice", "criteria": {
            "yes": "The action changes something that none of the approved items covers.",
            "no": "Every change the action makes is covered by the approved items.",
            "uncertain": "It is unclear whether some change falls outside the approved items."}, "instructions":
            f"Approved task scope items: {items}. Does the action in current_tool_call change anything that none "
            "of these approved items covers? Reading, listing or printing files is not a change."}
    for b in state["limits"]:
        q[f"limit/{b['id']}"] = {"type": "choice", "criteria": CRITERIA_LIMIT, "instructions":
            f"Task limit: «{b['text']}». Does the action in current_tool_call break this limit?"}
    return q
#=== END ===
#=== ASSET scope_proposal.py ===
"""Delegated tasks: the agent proposes a scope in a readable format, the user approves it, and
code turns the approved items into task bullets (the L2 recipe) without a model.

Owner design (2026-10-07): when the user leaves a task's details to a document or skill
("$local-ai ...", "do what requirements.md says"), the agent may only explore until it has
proposed a definitive scope and the user has approved it. The proposal format is easy to read
and parsed by code; one nudge if it is malformed, then one LLM call converts it.
"""
import re
from pathlib import Path

FORMAT = """Reply to the user with the scope in exactly this shape (plain Markdown):

**Scope**
1. <one kind of work, in one place>
2. ...

**Limits**
1. <what you will not do>

**Sources**
1. <the document or skill section each part comes from>

Then ask: Reply "yes" to approve, "yes, but not 2", or correct anything."""

INSTRUCTION = ("This task's details are in a document or skill the user pointed to. Read and explore "
               "first; do not change anything yet. " + FORMAT)

NUDGE = ("Your scope message does not follow the required format, so it cannot become the approved "
         "scope. Rewrite it now, nothing else. " + FORMAT)

SECTIONS = {"scope": "scope", "limits": "limits", "limit": "limits", "sources": "sources", "source": "sources"}
HEADING = re.compile(r"^\s*(?:#{1,6}\s*)?(?:\*\*|__)?\s*(scope|limits?|sources?)\s*(?:\*\*|__)?\s*:?\s*(?:\*\*|__)?\s*$", re.I)
ITEM = re.compile(r"^\s*(\d{1,2})[.)]\s+(.+?)\s*$")
DOC = re.compile(r"(?<![\w/.-])((?:~|\.{1,2})?/?[\w.-]+(?:/[\w.-]+)*\.(?:md|txt|rst|toml|ya?ml|json|org))\b", re.I)
DELEGATING = re.compile(r"\b(follow(ing)?|implement|execute|carry out|do (what|everything)|as (described|specified|written|listed) in|according to|per|instructions|steps|tasks?|spec(ification)?|requirements|plan)\b|\bsays\b", re.I)
TASK_FILE = re.compile(r"^(requirements|todo|tasks?|plan|spec|specification|instructions|brief)[\w.-]*\.\w+$", re.I)
SKILL = re.compile(r"(?<![\w$])\$([a-z][a-z0-9-]{1,40})\b")


def parse(text):
    """{'scope': [...], 'limits': [...], 'sources': [...]} from the readable format, or None.
    At least one numbered scope item is required; items keep their numbers' order."""
    if not isinstance(text, str):
        return None
    found, current = {"scope": [], "limits": [], "sources": []}, None
    for line in text.splitlines():
        heading = HEADING.match(line)
        if heading:
            current = SECTIONS[heading.group(1).lower()]
            continue
        item = ITEM.match(line)
        if item and current:
            value = item.group(2).strip().strip("*_").strip()
            if len(value) >= 4:
                found[current].append(value)
        elif line.strip() and current and not item and found[current] and line.startswith((" ", "\t")):
            found[current][-1] += " " + line.strip()   # an item continued on an indented line
    return found if found["scope"] else None


def intends_proposal(text):
    """Does the message look like an attempt at a scope proposal (to decide whether to nudge)?"""
    return isinstance(text, str) and bool(re.search(r"(?im)^\W*(scope|limits?)\b", text) or re.search(r"\bscope\b", text, re.I))


def delegated(prompt, cwd, skills_dirs=()):
    """Code check for a delegated task: the prompt names a skill ($name, if that skill exists)
    or an existing document file. Returns the references found (empty if none)."""
    refs = []
    for name in SKILL.findall(prompt or ""):
        if any((Path(d).expanduser() / name / "SKILL.md").is_file() for d in skills_dirs):
            refs.append(f"skill ${name}")
    for match in DOC.finditer(prompt or ""):
        path = match.group(1)
        p = Path(path).expanduser()
        p = p if p.is_absolute() else Path(cwd) / p
        # A document only counts when the message hands the task to it ("follow X", "do what X
        # says") or it is a task file by name; a file mentioned as input does not.
        near = (prompt or "")[max(0, match.start() - 60):match.end() + 25]
        if p.is_file() and (DELEGATING.search(near) or TASK_FILE.search(Path(path).name)):
            refs.append(f"file {path}")
    return refs


CONVERT = """Rewrite the agent's message below into exactly this format. Use only what the message
says; do not add anything. After each item, add the exact words from the message it comes from,
in double quotes, after a | sign.

**Scope**
1. <item> | "<exact words from the message>"

**Limits**
1. <item> | "<exact words from the message>"

**Sources**
1. <item> | "<exact words from the message>"

If the message proposes no scope at all, answer with the single word NONE."""


def parse_converted(answer, message):
    """Parse the LLM's conversion; keep only items whose quote appears in the original message."""
    parsed = parse(re.sub(r'\s*\|\s*"[^"]*"\s*$', "", answer or "", flags=re.M))
    if not parsed:
        return None
    quotes = {}
    for line in (answer or "").splitlines():
        m = re.match(r'^\s*\d{1,2}[.)]\s+(.+?)\s*\|\s*"(.+)"\s*$', line)
        if m:
            quotes[m.group(1).strip().strip("*_").strip()] = m.group(2)
    norm = lambda s: " ".join(s.lower().split())
    ok = lambda item: item in quotes and len(norm(quotes[item])) >= 6 and norm(quotes[item]) in norm(message)
    result = {k: [i for i in v if ok(i)] for k, v in parsed.items()}
    return result if result["scope"] else None
