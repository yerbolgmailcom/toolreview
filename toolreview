def answer(value):
    return {"type": "choice", "choice": value, "confidence": 1.0,
            "probabilities": {k: float(k == value) for k in ("yes", "no", "uncertain")}}


class Models:
    def __init__(self):
        self.uncertain = False
        self.applies = "yes"
        self.restriction = "no"
        self.offline = False
        self.calls = []
        self.llm_calls = 0
        self.llm_state = None
        self.llm_result = {"decision": "allow", "confidence": 1.0, "authorized": True,
                           "risk": "low", "reason": "Bounded inspection is authorized.", "can_make_rule": False, "turn_recipe": None}

    def jev(self, state, questions, model):
        self.calls.append(list(questions))
        if self.offline:
            raise OSError("offline")
        answers = {k: answer("yes" if k.rsplit("/", 1)[-1] in {"authorized", "safe", "applicability"} else "no") for k in questions}
        if "authorized" in questions and self.uncertain:
            answers["authorized"] = answer("uncertain")
        if "applies" in questions:
            answers["applies"] = answer(self.applies)
        if "restriction" in questions:
            answers["restriction"] = answer(self.restriction)
        return {"model": model, "answers": answers}

    def llm(self, state, answers):
        self.llm_calls += 1
        self.llm_state = copy.deepcopy(state)
        if self.offline:
            raise OSError("offline")
        return self.llm_result


