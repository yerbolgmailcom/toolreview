SHAPE_REMINDER = ('\n\nAnswer with the COMPLETE top-level JSON object of response_schema, starting with "decision", '
                  'then "reason", and with "authorization" as one nested field. Do not answer with only the authorization object.')

def redact_context(value):
    """Redact credential markers without silently truncating mandatory context."""
    if isinstance(value,dict):
        return {k:'[REDACTED]' if re.fullmatch(r'(?i)(password|api.?key|access.?token|secret|authorization)',k) and isinstance(v,str)
                else redact_context(v) for k,v in value.items()}
    if isinstance(value,list):return [redact_context(v) for v in value]
    if isinstance(value,str):return base.SECRET.sub('[REDACTED]',value)
    return base.redact(value)
def execution_evidence(action, verified_evidence=None, dependencies=(), launch_directory=None):
    """Host dependency facts + limited direct shell syntax, NOT a shell sandbox.

    No program-name allowlist. A native adapter must resolve aliases, wrappers,
    PATH and interpreter inputs independently; this prototype does not do so.
    """
    unknown = [d["path"] for d in dependencies if d.get("semantics_known") is not True]
    args = action.get("arguments") or {}
    command = next((args[k] for k in ("command", "cmd") if isinstance(args,dict) and isinstance(args.get(k),str)), None)
    if command:
        lexer=shlex.shlex(command,posix=True,punctuation_chars=";&|()")
        lexer.whitespace_split=True
        command_start=True
        for token in lexer:
            if token and all(ch in ";&|()" for ch in token):
                command_start=True;continue
            if command_start:
                if "=" in token and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*",token):continue
                local_path = "/" in token and not token.startswith("/")
                project_absolute = (token.startswith("/") and launch_directory and
                    Path(posixpath.normpath(token)).is_relative_to(Path(launch_directory)))
                if local_path or project_absolute: unknown.append(token)
                command_start=False
    contract = verified_evidence if isinstance(verified_evidence,dict) else {}
    matched = (contract.get("action_sha256")==base.digest(action) and
               isinstance(contract.get("verified_tool_contract"),str) and
               bool(contract["verified_tool_contract"].strip()))
    return {"unresolved_dependencies":sorted(set(unknown)) if not matched else [],
            "matched_current_host_contract":bool(matched), "coverage":"trusted host facts plus direct relative/project-local shell invocations"}

def absolute(path):
    if not isinstance(path, str) or not path.startswith("/"):
        raise ValueError("independent filesystem facts must contain absolute paths")
    return posixpath.normpath(path)

def workspace_evidence(state):
    """Deterministic provenance, never semantic task relevance or permission."""
    launch = absolute(state["launch_directory"])
    targets = state.get("write_targets")
    if not isinstance(targets, list) or not targets or not state.get("write_targets_complete"):
        return {"established": False, "reason": "Complete independent write targets unavailable."}
    proofs = []
    facts = {absolute(f["path"]): f for f in state.get("filesystem_facts", [])}
    for target in targets:
        target = absolute(target)
        fact = facts.get(target)
        if not fact:
            return {"established": False, "reason": "Target file state unavailable."}
        resolved = absolute(fact.get("resolved_path", target))
        if not Path(resolved).is_relative_to(Path(launch)) or RUNTIME.search(resolved):
            return {"established": False, "reason": "Target escapes the fixed launch boundary or is protected."}
        if fact.get("exists") is False:
            proofs.append({"path": target, "kind": "new", "resolved_path": resolved, "inside_launch_directory": True})
            continue
        established = None
        for prior in state.get("relevant_history", []):
            before = next((f for f in prior.get("filesystem_facts", []) if absolute(f["path"]) == target), None)
            if prior.get("route") != "allow" or not before or before.get("exists") is not False:
                continue
            for outcome in prior.get("execution_outcomes", []):
                if outcome.get("exit_code") != 0:
                    continue
                after = next((f for f in outcome.get("filesystem_after", []) if absolute(f["path"]) == target), None)
                if (after and after.get("exists") is True and after.get("identity") and
                    after["identity"] == fact.get("identity") and
                    absolute(after.get("resolved_path", target)) == resolved):
                    established = {"path": target, "kind": "successful_scope_creation", "review_id": prior["id"], "inside_launch_directory": True}
        if established is None:
            return {"established": False, "reason": "Existing target has no matched successful scope-creation evidence."}
        proofs.append(established)
    return {"established": True, "proofs": proofs}

# Stable, append-only parts first and per-action parts last, so consecutive
# reviews share a long prompt prefix that the model server can reuse from its
# cache. Same fields and values as before; only the order changes.
STABLE_FIRST = ("authorization_policy", "launch_directory", "active_reviewer_directory",
                "active_enforcement_paths", "review_scope", "conversation_context", "relevant_history")
PER_ACTION_LAST = ("authority_evidence", "selection_summary", "execution_evidence", "artifact_evidence",
                   "user_request", "filesystem_facts", "write_targets", "write_targets_complete", "proposed_action")

def llm_payload(state, answers):
    state = redact_context(state)
    known = STABLE_FIRST + PER_ACTION_LAST
    ordered = {k: state[k] for k in STABLE_FIRST if k in state}
    ordered.update({k: v for k, v in state.items() if k not in known})
    ordered.update({k: state[k] for k in PER_ACTION_LAST if k in state})
    authority = ordered.get("authority_evidence")
    if isinstance(authority, dict):
        # Its quoted sources are stable within a turn; the effects follow the action.
        ordered["authority_evidence"] = {**{k: authority[k] for k in ("sources", "contract", "omissions") if k in authority},
                                         **{k: v for k, v in authority.items() if k not in ("sources", "contract", "omissions")}}
    return {"response_schema": schema(), "state": ordered, "answers": answers}

def resolver_call(body, timeout=None):
    """toolreview: one request to the configured resolver (any OpenAI-compatible chat endpoint),
    with its model, key and per-model extra fields (e.g. a server's chat_template_kwargs)."""
    c = config.settings("resolver")
    if not c.get("url") or not c.get("model"):
        raise ValueError(f"no resolver configured (resolver.url or resolver.codex_provider, and resolver.model, in {config.path()})")
    return base.post_json(c["url"], {"model": c["model"], **body, **(c.get("extra_body") or {})},
                          config.secret("resolver"), timeout=timeout or c.get("timeout") or 55)

class Models(base.Models):
    def __init__(self, credential=None):
        super().__init__(json.loads((BASE/"base-schema.json").read_text()))
        self._key = credential
    def jev(self,state,questions,model):
        return super().jev(redact_context(state),questions,model)
    def final_reminded(self, state, answers):
        return self.final(state, answers, reminder=True)
    def final(self, state, answers, reminder=False):
        self.final_diagnostics = {"stage": "input"}
        system = SYSTEM
        content = json.dumps(llm_payload(state, answers), allow_nan=False) + (SHAPE_REMINDER if reminder else "")
        if len(content.encode()) > LLM_BYTES: raise ValueError("complete selected authoring input exceeds budget")
        self.final_diagnostics["stage"] = "transport"
        response = resolver_call({"messages": [{"role": "system", "content": system}, {"role": "user", "content": content}],
            "temperature": 0, "max_tokens": 2400, "stream": False,
            "response_format": {"type": "json_schema", "json_schema": {"name": "goal_review", "strict": True, "schema": schema()}}})
        item = response["choices"][0]
        self.final_diagnostics.update(stage="envelope", finish_reason=item.get("finish_reason"), usage=response.get("usage"))
        if item.get("finish_reason") != "stop" or item["message"].get("refusal"):
            raise ValueError("incomplete final response")
        self.final_diagnostics["stage"] = "parse"
        candidate = json.loads(item["message"]["content"])
        self.final_diagnostics.update(stage="validation", candidate=base.redact(candidate))
        try:
            result = validate_llm(candidate)
        except ValueError as exc:
            # These messages come from our validators, never HTTP error bodies.
            self.final_diagnostics["validation_error"] = str(exc)
            raise
        self.final_diagnostics["stage"] = "validated"
        return result

    def convert(self, message):
        """toolreview: one LLM call that restructures a malformed scope message (quotes checked by code)."""
        response = resolver_call({"messages": [{"role": "system", "content": scope_proposal.CONVERT},
                                               {"role": "user", "content": message[:12000]}],
                                  "temperature": 0, "max_tokens": 1200, "stream": False}, timeout=120)
        return response["choices"][0]["message"]["content"] or ""
    def extend(self, messages, current, action, outcome="allowed", reason=None):
        if outcome == "denied":
            return self.extract(messages, current, denied={"action": action, "reason": reason})
        return self.extract(messages, current, action)
    def extract(self, messages, current, approved=None, denied=None):
        """toolreview: scope and limit bullets from the user's messages (plain lines, no schema)."""
        response = resolver_call({
            "messages": [{"role": "system", "content": bullets.SYSTEM}, {"role": "user", "content": bullets.prompt(messages, current, approved, denied)}],
            "temperature": 0, "max_tokens": 1200, "stream": False}, timeout=120)
        return response["choices"][0]["message"]["content"] or ""

EFFECT_QUESTIONS = ("no_state_change", "secrets", "tampering", "destructive", "disclosure")

CURRENT_TOOL_CALL = ("proposed_action", "filesystem_facts", "write_targets")
EFFECT_PREFIX = "Answer about current_tool_call only; previous_context is background. "

def separated(lean):
    """toolreview: one Jev state for all questions, with the action under review
    marked apart from what came before. In a replay this kept plain reads fast
    (21 of 21, like an action-only state) while the effect questions still see
    the conversation."""
    current = {k: lean[k] for k in CURRENT_TOOL_CALL if k in lean}
    return {"previous_context": {k: v for k, v in lean.items() if k not in current}, "current_tool_call": current}

def jev_state(state):
    """Lean Jev context: the rulebook, the last 10 prompt/final-answer pairs,
    the current prompt, this turn's earlier actions (the same window the LLM
    sees, without tool output), the proposed action and the enforcement paths.
    Evidence plumbing (citation IDs, bookkeeping) stays with the LLM."""
    context = state.get("conversation_context") or {}
    pairs = context.get("turn_pairs")
    if pairs is None:
        pairs = turn_pairs(context.get("messages", []))
    lean = {
        "authorization_policy": state.get("authorization_policy"),
        "recent_conversation": [{"user": p["user"], "final_answer": p["final_answer"]} for p in pairs[-10:]],
        "current_prompt": state.get("user_request"),
        "omitted_earlier_actions": state.get("selection_summary", {}).get("omitted_earlier_actions", 0),
        "current_turn_actions": state.get("relevant_history", []),
        "proposed_action": state.get("proposed_action"),
        "launch_directory": state.get("launch_directory"),
        "active_reviewer_directory": state.get("active_reviewer_directory"),
        "active_enforcement_paths": state.get("active_enforcement_paths"),
    }
    for key in ("filesystem_facts", "write_targets"):
        if state.get(key):
            lean[key] = state[key]
    return lean

def owner_rules(settings):
    """toolreview: the owner's standing rules (base-schema.json "owner_rules"), each a Jev
    question whose confident yes denies at L1, with the reason shown to the agent."""
    rules = (settings or {}).get("owner_rules") or {}
    for name, rule in rules.items():
        if set(rule) != {"question", "deny_reason"} or not isinstance(rule["deny_reason"], str):
            raise ValueError("invalid owner rule")
        base.choice_question(rule["question"])
    return rules

def user_messages(scope, event):
    """The user's own words for this scope, oldest first: an active goal's objective, earlier
    user messages the host recorded, and this scope's prompts. Never assistant text."""
    messages = []
    if scope.goal and scope.goal["session_id"] == event["session_id"] and scope.goal["status"] == "active":
        messages.append(scope.goal["objective"])
    context = scope.conversation_context(event) or {}
    if context.get("messages"):
        messages += [m["text"] for m in context["messages"] if m.get("role") == "user" and m.get("text")]
    else:
        messages += [p["prompt"] for p in context.get("previous_user_prompts", [])]
    messages += [r["data"]["prompt"] for r in scope.records(event) if r["kind"] == "prompt"]
    seen, unique = set(), []
    for m in messages:
        if m not in seen:
            seen.add(m); unique.append(m)
    return unique

def prepare_turn(scope, event, models):
    """toolreview: write or extend this scope's bullets from the user's messages. Run by the
    background worker when a prompt arrives (and by evals); never inside a review."""
    approved = scope.read_session(event, "approved-scope.json")
    if approved and approved.get("needs_conversion") and hasattr(models, "convert"):
        parsed = scope_proposal.parse_converted(models.convert(approved["proposal"]), approved["proposal"])
        if parsed:
            approved = {**{k: v for k, v in approved.items() if k != "needs_conversion"}, "converted": True,
                        "approved": {"scope": approved_items(models, approved["proposal"], parsed["scope"], approved["approval"]),
                                     "limits": parsed["limits"]}}
            scope.write_session(event, "approved-scope.json", approved)
            scope.add_approved_scope(event, approved["approved"], approved["proposal"], approved["approval"])
    messages = user_messages(scope, event)
    if not messages:
        return None
    current = scope.bullets(event)
    fingerprint = base.digest(messages)
    if current.get("messages_digest") == fingerprint:
        return current
    answer = models.extract(messages, current)
    return scope.update_bullets(event, answer, messages, "prompt", digest=fingerprint)

DENY_REFUSED = "The user approved only part of the proposal, and this action belongs to the part they refused or skipped. Ask the user before doing this."
DENY_SCOPE = "The action falls outside the user's current task or contradicts its limits. Ask the user before doing this."

def approved_items(models, proposal, items, reply):
    """toolreview: which proposed scope items the user's reply approves (owner: no rule-based
    reading of the user's words). One Jev request: does the reply approve the proposal at all,
    and, per item, does it exclude, skip or postpone that item? An item counts when the overall
    answer is a confident yes and its exclusion a confident no. Read this way ("everything,
    minus what the reply leaves out") replies like "sure, but leave the deploy for later" came
    out right; asking per item "is it approved?" left out items approved only implicitly."""
    if not items:
        return []
    yn = lambda y, n, u: {"yes": y, "no": n, "uncertain": u}
    questions = {"overall": {"type": "choice", "instructions": "Does the user's reply approve the assistant's proposal, in full or in part?",
                             "criteria": yn("The reply approves the proposal, fully or partly.",
                                            "The reply declines the proposal or does not answer it.",
                                            "It is unclear whether the reply approves anything.")}}
    for i, text in enumerate(items, 1):
        # The item's number is in the question: replies often name numbers ("all except 3").
        questions[f"excluded_{i}"] = {"type": "choice", "instructions":
            f"Scope item {i} of the proposal: «{text}». Does the user's reply exclude, skip or postpone item {i}, "
            f"or approve only other items while leaving item {i} out?",
            "criteria": yn(f"The reply excludes, skips or postpones item {i}, or approves only other items.",
                           f"The reply does not exclude item {i}.", f"It is unclear whether the reply excludes item {i}.")}
    answers = models.jev({"assistant_proposal": proposal, "user_reply": reply}, questions, MODEL)["answers"]
    if not clear(answers.get("overall"), "yes"):
        return []
    return [text for i, text in enumerate(items, 1) if clear(answers.get(f"excluded_{i}"), "no")]

DELEGATED_QUESTION = {"type": "choice", "criteria": {
    "yes": "The message points to a document, skill or file for the task's details.",
    "no": "The message states the task itself (or there is no task change).",
    "uncertain": "It is unclear whether the details are left to another source."},
    "instructions": "Does the user's current message leave the task's details to a document, skill or file it "
                    "points to (for example \"do what requirements.md says\" or \"$skill ...\"), instead of stating them itself?"}

def cascade(answers, state, rules, scope_bullets, known_deletes, code_veto, needs_scope=False):
    """toolreview: layers L1 (owner's base questions) and L2 (task bullets). Each layer has an
    allow set and a deny set; returns (route, reason, layer), or None when both are uncertain."""
    route, reason = compose(answers)
    if route == "deny":
        return "deny", reason, "L1"
    if route == "allow" and not code_veto:
        return "allow", reason, "L1"
    accepted = clear(answers.get("proposal_presented"), "yes") and authority.approved(answers)
    if clear(answers.get("existing_scope"), "no", .9, .95) and not accepted:
        return "deny", DENY_SCOPE, "L1"
    if authority.picked(answers.get("approval"), ("partial_excluded",)):
        return "deny", DENY_REFUSED, "L1"
    for name, rule in rules.items():
        if clear(answers.get(name), "yes"):
            return "deny", rule["deny_reason"], "L1"
    if needs_scope:
        # toolreview: a delegated task without an approved scope: explore only.
        return "deny", scope_proposal.INSTRUCTION, "L1"
    for b in scope_bullets["limits"]:
        if clear(answers.get(f"limit/{b['id']}"), "yes"):
            return "deny", f"The action breaks the task limit '{b['text']}' (the user's words: \"{b['quote']}\"). Ask the user before doing this.", "L2"
    destructive_ok = clear(answers.get("destructive"), "no") or (state.get("artifact_evidence") or {}).get("established")
    safe = (all(clear(answers.get(k), "no") for k in ("secrets", "tampering", "disclosure")) and destructive_ok
            and not known_deletes and clear(answers.get("existing_scope"), "yes"))
    for b in scope_bullets["scope"]:
        if safe and clear(answers.get(f"scope/{b['id']}"), "yes"):
            return "allow", f"Covered by the task scope '{b['text']}' (the user's words: \"{b['quote']}\").", "L2"
    if safe and clear(answers.get("scope/outside_approved"), "no"):
        return "allow", "Covered by the scope the user approved, taken together.", "L2"
    return None

class Arbiter:
    def __init__(self, scope, models):
        self.scope, self.models = scope, models
        self.rules = owner_rules(getattr(models, "settings", {}))
    def review(self, event, action, facts=(), targets=None, targets_complete=False, force_fallback=False, verified_evidence=None, execution_dependencies=()):
        receipts, answers, llm = [], {}, None
        state = {"user_request": "", "authorization_policy": AUTHORIZATION,
                 "review_scope": str(self.scope.resolve(event).relative_to(self.scope.root)),
                 "launch_directory": self.scope.launch_directory, "proposed_action": copy.deepcopy(action),
                 "filesystem_facts": copy.deepcopy(list(facts)), "write_targets": targets,
                 "write_targets_complete": targets_complete}
        if verified_evidence is not None:
            state["verified_evidence"] = copy.deepcopy(verified_evidence)
        def finish(route, reason, layer="L0", **extra):
            # toolreview: there is no human step; anything unresolved is a deny whose
            # reason tells the agent what to ask the user.
            if route == "human": route = "deny"
            actor_reason = base.actor_explanation(reason, "The action could not be cleared; ask the user how to proceed.")
            record = self.scope.append(event, "review", {"tool_use_id": event.get("tool_use_id"),
                "state": state, "route": route, "reason": reason, "receipts": receipts, "answers": answers, "llm": llm,
                "action_hash": base.digest(action),
                "actor_reason": actor_reason, "llm_diagnostics": getattr(self.models, "final_diagnostics", None),
                # toolreview: which script version (sha256 of the script) reviewed this.
                "reviewer_version": os.environ.get("TOOLREVIEW_VERSION"), "layer": layer, **extra})
            return {"route": route, "reason": reason, "actor_reason": actor_reason, "record": record}
        try:
            state["user_request"] = self.scope.request(event)
            state["conversation_context"] = self.scope.conversation_context(event)
            state["active_reviewer_directory"] = str(self.scope.root)
            # toolreview: the script passes the reviewer's own files (state folder,
            # project hooks, Codex config, script, code cache) to protect.
            state['active_enforcement_paths'] = ([p for p in os.environ.get('TOOLREVIEW_ENFORCEMENT_PATHS', '').split(':') if p]
                or [str(self.scope.root), *(str(Path(config.settings('codex')['home']) / n) for n in ('config.toml', 'hooks.json'))])
            raw = json.dumps(action, ensure_ascii=False)
            if base.SECRET.search(raw): return finish("human", "Literal credentials cannot be sent to assessment services.")
            if len(raw.encode()) > 96000: return finish("human", "Action exceeds the 96KB complete-assessment budget; split it into smaller actions.")
            for fact in facts:
                target = Path(fact.get('resolved_path', fact['path']))
                if targets_complete and (target == self.scope.root or target.is_relative_to(self.scope.root)):
                    return finish('deny', 'The action writes active review policy or approval artifacts; use independent human administration.')
            records = self.scope.records(event)
            authority_records=records
            if not any(r['kind']=='prompt' and r['data'].get('execution_turn_id')==event['turn_id'] for r in records):
                # Creating a native goal mid-turn changes storage scope, not the
                # provenance of the already submitted user prompt.
                index=self.scope.root/'sessions'/base.safe_id(event['session_id'])/'user-prompts'
                for path in sorted(index.glob('*.json'),reverse=True):
                    prompt=json.loads(path.read_text())
                    if prompt['kind']=='prompt' and prompt['data'].get('execution_turn_id')==event['turn_id']:
                        authority_records=[*records,prompt];break
            state['authority_evidence'] = authority.build(state,event,authority_records,self.scope.goal)
            if any(r["kind"] in {"end", "goal_end"} for r in records): return finish("human", "Effective review scope has ended.")
            if not state["user_request"]: return finish("human", "No trusted prompt or active goal objective.")
            scoped = scoped_history(records)
            # Provenance of task-created files is established from the full
            # scoped records (with outcomes, across a goal's turns) in code;
            # the models see a lean window of this turn's actions.
            state["relevant_history"] = scoped
            state["execution_evidence"] = execution_evidence(action, verified_evidence, execution_dependencies, self.scope.launch_directory)
            # Unknown script semantics are evidence for the models, not a ban
            # on executing requested scripts/tests/builds.
            state["artifact_evidence"] = workspace_evidence(state)
            kept, omitted = action_window([h for h in scoped if h.get("execution_turn_id") in (None, event.get("turn_id"))])
            state["relevant_history"] = kept
            state["selection_summary"] = {"omitted_earlier_actions": omitted,
                                          "note": "Tool outputs are not included; earlier actions are listed with the reviewer's decisions."}
            scope_bullets = self.scope.bullets(event)
            q = copy.deepcopy(getattr(self.models, 'settings', {}).get('questions') or questions())
            q.pop('authorized',None)
            q.update(authority.questions())
            # toolreview: one Jev request with every question batched. The effect questions
            # are told to judge only current_tool_call; without that, earlier downloads made
            # Jev rate plain reads as state-changing.
            q = {k: ({**v, "instructions": EFFECT_PREFIX + v["instructions"]} if k in EFFECT_QUESTIONS else v) for k, v in q.items()}
            q.update({name: rule["question"] for name, rule in self.rules.items()})
            q.update(bullets.questions(scope_bullets))
            q["delegated_task"] = DELEGATED_QUESTION
            lean = jev_state(state)
            payload = separated(lean)
            known_deletes = any(e['kind']=='delete' for e in state['authority_evidence']['effects'])
            code_veto = None
            if known_deletes:
                code_veto = 'Literal deletion operands require source-bound authorization.'
            elif state['execution_evidence']['unresolved_dependencies']:
                code_veto = 'A helper name alone does not prove read-only behavior.'
            elif targets_complete and targets:
                code_veto = "Independent write targets contradict the observation judgment."
            jev_error = None
            try:
                response = self.models.jev(payload, q, MODEL)
                if response.get("model") != MODEL or set(response.get("answers", {})) != set(q): raise ValueError("invalid base response")
                answers = copy.deepcopy(response["answers"])
                receipts.append({"stage": "base_and_recipe", "questions": q, "result": response,
                                 "jev_state": payload, "jev_state_bytes": len(base.canonical(payload))})
            except Exception as exc:
                # toolreview: a classifier failure goes to the LLM, not to the human.
                jev_error = type(exc).__name__
                answers = {}
                receipts.append({"stage": "base_and_recipe", "error": jev_error})
            state["task_bullets"] = bullets.render(scope_bullets)
            state["review_context"] = {"base_schema": {"engine": "general-task-v1", "authorization_contract":"source-bound-v1", "questions": questions()},
                "task_bullets": scope_bullets, "classifier_error": jev_error,
                "execution_turn_id": event["turn_id"], "scope": state["review_scope"]}
            if jev_error is None:
                delegated = bool(self.scope.delegated(event)) or clear(answers.get("delegated_task"), "yes", .9, .95)
                needs_scope = delegated and not bullets.has_approved_scope(scope_bullets)
                decided = cascade(answers, state, self.rules, scope_bullets, known_deletes, code_veto, needs_scope)
                if decided and (decided[0] == "deny" or not force_fallback):
                    return finish(decided[0], decided[1], layer=decided[2],
                                  **({"needs_scope": True} if decided[1] == scope_proposal.INSTRUCTION else {}))
            state["current_evaluation"] = {"questions": q, "answers": answers}
            try:
                try:
                    llm = validate_llm(self.models.final(state, answers))
                except ValueError:
                    # toolreview: one retry, with a reminder of the answer's shape.
                    llm = validate_llm(getattr(self.models, "final_reminded", self.models.final)(state, answers))
            except Exception as exc:
                stage = (getattr(self.models, "final_diagnostics", None) or {}).get("stage", "llm")
                return finish("deny", f"The review service failed at {stage} ({type(exc).__name__}); the action was not run. Retry.", layer="L3", error=type(exc).__name__)
            decided, reason = final_route(llm, bool((targets_complete and targets) or known_deletes),state,answers)
            if decided=='allow' and llm['effects']=='change':
                # References only, never persisted model-written permission.
                # Native adapter validates membership in the live branch again.
                sources=state['authority_evidence']['sources']
                refs={c['source_id'] for c in llm['authorization']['evidence']}
                start=next((i for i,m in enumerate(sources) if m['id'] in refs),len(sources))
                refs.update(m['id'] for m in sources[start:] if m['role']=='user')
                path=self.scope.root/'sessions'/base.safe_id(event['session_id'])/'authority-pins.json'
                path.parent.mkdir(parents=True,exist_ok=True)
                pinned={m['id']:m['turn_id'] for m in sources if m['id'] in refs and m['role'] in ('user','assistant')}
                base.atomic_replace(path,{'source_ids':sorted(pinned),'source_turns':pinned})
