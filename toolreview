"""toolreview eval: run the real reviewer (Arbiter.review) on frozen cases.

A case set is a folder with contexts/*.json (conversation, the scope's earlier records,
session and turn ids, launch directory) and cases/*.json (the event, write targets, file
facts and the label allow or deny). Each case runs in a throwaway review folder; nothing
outside it is read or written except the components' network calls.

Components are swappable through the environment (TOOLREVIEW_CLASSIFIER_URL,
TOOLREVIEW_CLASSIFIER_MODEL, TOOLREVIEW_RESOLVER_URL, TOOLREVIEW_RESOLVER_MODEL). Every run
writes meta.json (script version and components), results.jsonl, summary.txt and
calls.jsonl.gz (every component input and output), so a run can be replayed without
calling any model (--replay) when only routing or thresholds changed.

usage: eval.py <set dir> [--repeats N] [--only ID,...] [--out DIR] [--replay RUN_DIR] [--workers N]
       eval.py --compare RUN_A RUN_B
"""
import argparse, collections, concurrent.futures as cf, datetime, gzip, json, os, shutil, sys, tempfile, threading, time
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
os.environ.setdefault("TOOLREVIEW_CODE_POLICY", "1")
import arbiter, config, prototype
from prototype import Scope, base


class ReplayMiss(Exception):
    pass


class Recorder:
    """Wraps the reviewer's models: records every call, or answers from a recorded run."""
    llm_slots = threading.Semaphore(int(os.environ.get("TOOLREVIEW_EVAL_LLM_PARALLEL", "2")))

    def __init__(self, inner, case_key, replay=None, context_key=None):
        self.inner, self.case_key, self.replay, self.context_key = inner, case_key, replay, context_key
        self.calls, self.count = [], collections.Counter()
        self.settings = getattr(inner, "settings", {})

    @property
    def final_diagnostics(self):
        return getattr(self.inner, "final_diagnostics", None)

    def _call(self, kind, fn, args, fingerprint):
        n = self.count[kind]; self.count[kind] += 1
        key = f"{self.context_key if kind == 'bullets' else self.case_key}|{kind}|{n}"
        if self.replay is not None:
            saved = self.replay.get(key)
            if saved is None or saved["fingerprint"] != fingerprint:
                raise ReplayMiss(key)
            if "error" in saved:
                # Re-raise the recorded type where it matters to the reviewer (a malformed
                # answer is a ValueError and gets the one retry).
                kind, _, message = saved["error"].partition(": ")
                raise {"ValueError": ValueError, "TimeoutError": TimeoutError}.get(kind, RuntimeError)(message)
            return saved["response"]
        start = time.time()
        try:
            response = fn(*args)
            self.calls.append({"key": key, "kind": kind, "fingerprint": fingerprint, "input": args[:2] if kind == "jev" else args,
                               "response": response, "seconds": round(time.time() - start, 3)})
            return response
        except Exception as exc:
            self.calls.append({"key": key, "kind": kind, "fingerprint": fingerprint, "input": args[:2],
                               "error": f"{type(exc).__name__}: {exc}", "seconds": round(time.time() - start, 3),
                               "diagnostics": getattr(self.inner, "final_diagnostics", None) if kind == "final" else None})
            raise

    def jev(self, state, questions, model):
        return self._call("jev", self.inner.jev, (state, questions, model), sorted(questions))

    def final(self, state, answers):
        with self.llm_slots:
            return self._call("final", self.inner.final, (state, answers), "final")

    def final_reminded(self, state, answers):
        with self.llm_slots:
            return self._call("final", self.inner.final_reminded, (state, answers), "final")

    def extend(self, messages, current, action, outcome="allowed", reason=None):
        with self.llm_slots:
            return self._call("extend", self.inner.extend, (messages, current, action, outcome, reason), "extend")

    def extract(self, messages, current):
        """Turn bullets from the user's messages (only when the reviewer has bullet recipes)."""
        with self.llm_slots:
            return self._call("bullets", self.inner.extract, (messages, current), "bullets")


def load_set(folder):
    folder = Path(folder)
    contexts = {p.stem: json.loads(p.read_text()) for p in sorted((folder / "contexts").glob("*.json"))}
    cases = [json.loads(p.read_text()) for p in sorted((folder / "cases").glob("*.json"))]
    return contexts, cases


def make_scope(ctx):
    root = Path(tempfile.mkdtemp(prefix="toolreview-eval-")) / ".toolreview"
    events = root / "turns" / base.safe_id(ctx["session_id"]) / base.safe_id(ctx["turn_id"]) / "events"
    events.mkdir(parents=True)
    for record in ctx["records"]:
        (events / f"{record['id']}.json").write_text(json.dumps(record))
    scope = Scope(root, ctx["launch_directory"])
    scope.native_conversation = ctx["conversation_context"]
    return scope


PREPARED, PREPARE_LOCKS, LOCK = {}, collections.defaultdict(threading.Lock), threading.Lock()


def prepared_bullets(ctx, repeat, models, event):
    """The bullets the prompt-time step writes, once per context and repeat (as the hook
    does once per prompt), shared by that context's cases."""
    key = (ctx["id"], repeat)
    with LOCK:
        lock = PREPARE_LOCKS[key]
    with lock:
        if key not in PREPARED:
            scope = make_scope(ctx)
            try:
                arbiter.prepare_turn(scope, event, models)
                path = scope.resolve(event) / "bullets.json"
                PREPARED[key] = json.loads(path.read_text()) if path.exists() else None
            finally:
                shutil.rmtree(scope.root.parent, ignore_errors=True)
        return PREPARED[key]


def run_sequence(case, ctx, repeat, replay):
    """All steps in one review folder, in order: records and bullets carry forward as in a real
    turn. Each step is scored on its own as <sequence id>-s<n>."""
    inner = arbiter.Models()
    scope = make_scope(ctx)
    outs, calls = [], []
    try:
        first = case["steps"][0]["event"]
        prep = Recorder(inner, f"{case['id']}#{repeat}/prepare", replay, context_key=f"{case['id']}#{repeat}")
        try:
            if hasattr(arbiter, "prepare_turn"):
                arbiter.prepare_turn(scope, first, prep)
        except ReplayMiss:
            pass
        calls += prep.calls
        for n, step in enumerate(case["steps"], 1):
            sid = f"{case['id']}-s{n}"
            models = Recorder(inner, f"{sid}#{repeat}", replay)
            event = step["event"]
            action = {"tool_name": event["tool_name"], "arguments": event["tool_input"], "cwd": event["cwd"]}
            start = time.time()
            try:
                result = arbiter.Arbiter(scope, models).review(event, action, step["filesystem_facts"],
                                                               step["write_targets"], step["write_targets_complete"])
                data = result["record"]["data"]
                out = {"route": result["route"], "decision": "allow" if result["route"] == "allow" else "deny",
                       "layer": data.get("layer") or ("LLM" if data.get("llm") else "before LLM"), "reason": result["reason"],
                       "llm_called": models.count["final"] > 0}
            except ReplayMiss as miss:
                out = {"route": "error", "decision": "error", "layer": "replay miss", "reason": str(miss), "llm_called": False}
            out.update(id=sid, sequence=case["id"], step=n, label=step["label"], repeat=repeat,
                       seconds=round(time.time() - start, 2), jev_calls=models.count["jev"], llm_calls=models.count["final"],
                       bullet_calls=models.count["extend"], bullets_after=scope.bullets(event) if hasattr(scope, "bullets") else None)
            outs.append(out); calls += models.calls
    finally:
        shutil.rmtree(scope.root.parent, ignore_errors=True)
    return outs, calls


def run_case(case, ctx, repeat, replay):
    key = f"{case['id']}#{repeat}"
    inner = arbiter.Models()
    models = Recorder(inner, key, replay, context_key=f"{ctx['id']}#{repeat}")
    if hasattr(arbiter, "prepare_turn"):   # bullet recipes: what the prompt-time step would have written
        try:
            value = prepared_bullets(ctx, repeat, models, case["event"])
        except ReplayMiss:
            value = None
    scope = make_scope(ctx)
    event = case["event"]
    action = {"tool_name": event["tool_name"], "arguments": event["tool_input"], "cwd": event["cwd"]}
    start = time.time()
    try:
        if hasattr(arbiter, "prepare_turn") and value:
            path = scope.resolve(event) / "bullets.json"
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(value))
        result = arbiter.Arbiter(scope, models).review(event, action, case["filesystem_facts"],
                                                       case["write_targets"], case["write_targets_complete"])
        data = result["record"]["data"]
        route = result["route"]
        out = {"route": route, "decision": "allow" if route == "allow" else "deny",
               "layer": data.get("layer") or ("LLM" if data.get("llm") else "before LLM"),
               "reason": result["reason"], "llm_called": bool(data.get("llm")) or models.count["final"] > 0}
    except ReplayMiss as miss:
        out = {"route": "error", "decision": "error", "layer": "replay miss", "reason": str(miss), "llm_called": False}
    finally:
        shutil.rmtree(scope.root.parent, ignore_errors=True)
    out.update(id=case["id"], label=case["label"], repeat=repeat, seconds=round(time.time() - start, 2),
               jev_calls=models.count["jev"], llm_calls=models.count["final"], bullet_calls=models.count["bullets"] + models.count["extend"])
    return out, models.calls


def summarize(results, repeats):
    lines = []
    by_case = collections.defaultdict(list)
    for r in results:
        by_case[r["id"]].append(r)
    final = {}
    for cid, rs in sorted(by_case.items()):
        votes = collections.Counter(r["decision"] for r in rs)
        final[cid] = (votes.most_common(1)[0][0], rs[0]["label"], len(votes) > 1,
                      collections.Counter(r["layer"] for r in rs).most_common(1)[0][0])
    for label in ("allow", "deny"):
        rows = [v for v in final.values() if v[1] == label]
        outcome = collections.Counter(f"{v[0]}@{v[3]}" for v in rows)
        lines.append(f"{label} cases ({len(rows)}): " + ", ".join(f"{k} {n}" for k, n in sorted(outcome.items())))
    false_allow = sorted(c for c, v in final.items() if v[1] == "deny" and v[0] == "allow")
    false_deny = sorted(c for c, v in final.items() if v[1] == "allow" and v[0] == "deny")
    errors = sorted(c for c, v in final.items() if v[0] == "error")
    unstable = sorted(c for c, v in final.items() if v[2])
    llm = sum(r["llm_calls"] > 0 for r in results)
    bullet_calls = sum(r.get("bullet_calls", 0) for r in results)
    secs = [r["seconds"] for r in results]
    lines += [f"false allows: {len(false_allow)} {false_allow}",
              f"false denies: {len(false_deny)} {false_deny}",
              f"errors: {len(errors)} {errors}",
              f"reviews decided by the LLM: {llm} of {len(results)}; bullet-writing LLM calls: {bullet_calls}",
              f"seconds per review: median {sorted(secs)[len(secs)//2]:.2f}, max {max(secs):.2f}",
              f"cases whose decision differed between {repeats} repeats: {len(unstable)} {unstable}"]
    return "\n".join(lines), final


def compare(a, b):
    def load(d):
        return {json.loads(l)["id"]: json.loads(l) for l in open(Path(d) / "results.jsonl")}
    ra, rb = load(a), load(b)
    print(f"A: {a}\nB: {b}")
    for cid in sorted(set(ra) | set(rb)):
        x, y = ra.get(cid), rb.get(cid)
        if not x or not y or (x["decision"], x["layer"]) != (y["decision"], y["layer"]):
            fx = f"{x['decision']}@{x['layer']}" if x else "-"
            fy = f"{y['decision']}@{y['layer']}" if y else "-"
            print(f"{cid:22} label {(x or y)['label']:5}  {fx:24} -> {fy}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("set", nargs="?")
    ap.add_argument("--repeats", type=int, default=1)
    ap.add_argument("--only")
    ap.add_argument("--out")
    ap.add_argument("--replay")
    ap.add_argument("--workers", type=int, default=6)
    ap.add_argument("--compare", nargs=2)
    args = ap.parse_args()
    if args.compare:
        return compare(*args.compare)
    contexts, cases = load_set(args.set)
    if args.only:
        wanted = set(args.only.split(","))
        cases = [c for c in cases if c["id"] in wanted]
    replay = None
    if args.replay:
        replay = {}
        with gzip.open(Path(args.replay) / "calls.jsonl.gz", "rt") as f:
            for line in f:
                call = json.loads(line); replay[call["key"]] = call
    version = os.environ.get("TOOLREVIEW_VERSION", "unknown")
    meta = {"set": str(Path(args.set).resolve()), "cases": len(cases), "repeats": args.repeats,
            "started": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds"),
            "script_sha256": version, "replay_of": args.replay,
            "classifier": {k: v for k, v in config.settings("classifier").items() if k in ("url", "model")},
            "resolver": {k: v for k, v in config.settings("resolver").items() if k in ("url", "model", "codex_provider", "extra_body")},
            "config_file": str(config.path())}
    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    out = Path(args.out or Path(args.set) / "runs" / f"{stamp}-{version[:8]}{'-replay' if replay else ''}")
    out.mkdir(parents=True, exist_ok=True)
    jobs = [(c, r) for r in range(args.repeats) for c in cases]
    results, calls = [], []
    with cf.ThreadPoolExecutor(args.workers) as pool:
        futures = [pool.submit(run_sequence if "steps" in c else run_case, c, contexts[c["context"]], r, replay) for c, r in jobs]
        for i, fut in enumerate(cf.as_completed(futures), 1):
            res, cl = fut.result(); calls.extend(cl)
            for one in (res if isinstance(res, list) else [res]):
                results.append(one)
                print(f"[{i}/{len(jobs)}] {one['id']}#{one['repeat']} {one['label']}: {one['decision']}@{one['layer']} ({one['seconds']}s)", flush=True)
    results.sort(key=lambda r: (r.get("sequence", r["id"]), r.get("step", 0), r["repeat"]))
    meta["finished"] = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
